// --- PRESET: EXACT 14-STEP WORK EXPERIMENT FROM YOUR SHEETS ---
function loadWorkExperimentPreset() {
  cmdNew(true);
  document.getElementById('window-title').textContent = 'Interactive Physics - [Work_Experiment.ip]';

  // Step 1: Create a body of mass 10, no friction, at the origin (0, 0.5)
  const block = createBody({
    name: 'Body[1]',
    shape: 'rect',
    x: 0,
    y: 0.5,
    width: 1.0,
    height: 1.0,
    mass: 10,
    staticFriction: 0,
    kineticFriction: 0,
    color: '#99ccff'
  });

  // Step 2: Create axis body (surface) with width w=200, and no friction
  createBody({
    name: 'Body[2]',
    shape: 'rect',
    x: 0,
    y: -0.25,
    width: 200,
    height: 0.5,
    mass: 1000,
    staticFriction: 0,
    kineticFriction: 0,
    anchored: true,
    color: '#d4d0c8'
  });

  // Step 3: Apply force with fx=10, fy=0, then make it polar
  const force = createForce({
    bodyId: block.id,
    isPolar: true,
    mag: 10,
    dir: 0
  });

  // Step 4 & 5: Create Controls for Magnitude (min 0, max 10) & Direction (min 0, max 360) as Text Boxes
  const ctrlMag = {
    id: nextId.control++,
    name: 'Input[1]',
    label: 'Magnitude',
    targetType: 'force',
    targetId: force.id,
    prop: 'magnitude',
    style: 'textbox',
    min: 0,
    max: 10,
    value: 10,
    left: 20,
    top: 25
  };
  const ctrlDir = {
    id: nextId.control++,
    name: 'Input[2]',
    label: 'Direction (θ°)',
    targetType: 'force',
    targetId: force.id,
    prop: 'direction',
    style: 'textbox',
    min: 0,
    max: 360,
    value: 0,
    left: 205,
    top: 25
  };
  state.controls.push(ctrlMag, ctrlDir);
  spawnControlWidget(ctrlMag);
  spawnControlWidget(ctrlDir);

  // Step 6: Set equation of fy (direction) as Input[2]*pi/180
  force.magFormula = 'Input[1]';
  force.dirFormula = 'Input[2]*pi/180';
  updateForceComponents(force);

  // Step 7 & 8: Measure -> Kinetic Energy -> Translational, and add y2: W = |ConstraintForce[1]|*Body[1].P.X*cos(Input[2]*pi/180)
  createMeasure('KineticEnergy', 'Graph', {
    y1Label: 'KE (J)',
    y1Formula: 'Body[1].KE',
    y2Label: 'W (N.m)',
    y2Formula: '|ConstraintForce[1]|*Body[1].P.X*cos(Input[2]*pi/180)'
  });

  // Step 9: View -> Numbers and units -> Fixed point, 0 digits
  state.decimalDigits = 0;

  // Step 10: World -> Pause control -> Body[1].P.X>=3 and Body[1].P.X<=-3
  state.pauseConditions = ['Body[1].P.X>=3', 'Body[1].P.X<=-3'];

  // Step 11: World -> Accuracy -> 100 f/s
  state.accuracyFPS = 100;
  document.getElementById('status-fps').textContent = '100 f/s';

  selectObject('force', force.id);
  openFloatingWin('win-properties');
  updateUIReadouts();
  render();
  setStatus('Loaded 14-Step Work Experiment! Change Direction (θ°), click Run, and observe W (N.m).');
}

// --- STEP 12-14: INTERACTIVE TABLE & GRAPH OF W VS THETA ---
function openPlotWvsThetaModal() {
  const angles = [0, 45, 90, 135, 180, 225, 270, 315, 360];
  // Calculate theoretical & simulated work W = F * d * cos(theta) for d = 3m, F = 10N
  const rows = angles.map(deg => {
    const rad = deg * Math.PI / 180;
    const wVal = Math.round(10 * 3 * Math.cos(rad));
    return `<tr>
      <td style="border:1px solid #808080; padding:3px 8px;">${deg}°</td>
      <td style="border:1px solid #808080; padding:3px 8px; font-weight:bold;">${wVal} N.m</td>
    </tr>`;
  }).join('');

  showModal('Steps 12–14: Work (W) vs Angle (θ) Table & Graph', `
    <div style="display:flex; gap:12px; align-items:flex-start;">
      <table style="border-collapse:collapse; background:white; text-align:center;">
        <tr style="background:#d4d0c8;">
          <th style="border:1px solid #808080; padding:4px 8px;">θ°</th>
          <th style="border:1px solid #808080; padding:4px 8px;">Work (W) N.m</th>
        </tr>
        ${rows}
      </table>
      <div>
        <canvas id="w-theta-canvas" width="240" height="180" style="background:white; border:1px solid #808080;"></canvas>
        <div style="font-size:10px; margin-top:4px; color:#222;">
          <b>Conclusion:</b> Work $W = F \\cdot \\Delta x \\cdot \\cos(\\theta)$ is maximum (+30 J) at 0° & 360°, zero at 90° & 270°, and negative (-30 J) at 180° (opposing motion).
        </div>
      </div>
    </div>
    <div style="text-align:right; margin-top:10px;">
      <button class="win-action-btn" onclick="closeModal()">Close</button>
    </div>
  `);

  // Draw W vs Theta Cosine Curve
  setTimeout(() => {
    const c = document.getElementById('w-theta-canvas');
    if (!c) return;
    const g = c.getContext('2d');
    const w = c.width, h = c.height;
    g.strokeStyle = '#808080';
    g.beginPath(); g.moveTo(25, h / 2); g.lineTo(w - 10, h / 2); g.moveTo(25, 10); g.lineTo(25, h - 10); g.stroke();
    g.fillStyle = '#000'; g.font = '9px Tahoma';
    g.fillText('+30', 2, 20); g.fillText('0', 12, h / 2 + 3); g.fillText('-30', 2, h - 15);
    g.fillText('0°', 25, h / 2 + 12); g.fillText('180°', 115, h / 2 + 12); g.fillText('360°', 210, h / 2 + 12);

    g.strokeStyle = '#0000cc';
    g.lineWidth = 2;
    g.beginPath();
    for (let deg = 0; deg <= 360; deg += 5) {
      const px = 25 + (deg / 360) * (w - 40);
      const val = 30 * Math.cos(deg * Math.PI / 180);
      const py = (h / 2) - (val / 30) * (h / 2 - 18);
      if (deg === 0) g.moveTo(px, py); else g.lineTo(px, py);
    }
    g.stroke();
  }, 50);
}

