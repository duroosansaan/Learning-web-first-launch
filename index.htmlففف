  const header = el.querySelector('.fw-header, .cw-title');
  if (!header) return;
  let startX, startY, origLeft, origTop;
  header.addEventListener('mousedown', (e) => {
    e.stopPropagation();
    startX = e.clientX;
    startY = e.clientY;
    origLeft = el.offsetLeft;
    origTop = el.offsetTop;
    el.style.right = 'auto';

    function onMove(ev) {
      el.style.left = (origLeft + ev.clientX - startX) + 'px';
      el.style.top = (origTop + ev.clientY - startY) + 'px';
    }
    function onUp() {
      window.removeEventListener('mousemove', onMove);
      window.removeEventListener('mouseup', onUp);
    }
    window.addEventListener('mousemove', onMove);
    window.addEventListener('mouseup', onUp);
  });
}

// Menu Bar Interaction
document.querySelectorAll('.menu-item').forEach(item => {
  item.addEventListener('click', (e) => {
    e.stopPropagation();
    const wasActive = item.classList.contains('active');
    closeAllMenus();
    if (!wasActive) item.classList.add('active');
  });
  item.addEventListener('mouseenter', () => {
    if (document.querySelector('.menu-item.active')) {
      closeAllMenus();
      item.classList.add('active');
    }
  });
});
function closeAllMenus() {
  document.querySelectorAll('.menu-item').forEach(m => m.classList.remove('active'));
}
window.addEventListener('click', closeAllMenus);

// Keyboard Shortcuts
window.addEventListener('keydown', (e) => {
  if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA') return;
  if (e.key === 'Delete') cmdDelete();
  if (e.ctrlKey && e.key.toLowerCase() === 'i') { e.preventDefault(); openFloatingWin('win-properties'); }
  if (e.ctrlKey && e.key.toLowerCase() === 'd') { e.preventDefault(); cmdDuplicate(); }
  if (e.key === ' ') { e.preventDefault(); state.running ? stopSim() : runSim(); }
});

function formatNum(val) {
  if (typeof val !== 'number' || isNaN(val)) return '0';
  return val.toFixed(state.decimalDigits);
}

function updateUIReadouts() {
  document.getElementById('status-time').textContent = `Time: ${state.time.toFixed(2)} s`;
}

function setStatus(msg) {
  document.getElementById('status-msg').textContent = msg;
}

// Initialize draggable floating windows and default scene
['win-properties', 'win-appearance', 'win-geometry'].forEach(id => {
  makeDraggable(document.getElementById(id));
});

resizeCanvas();
// Start with a clean workspace or default ground & block ready to test
createBody({ name: 'Body[1]', shape: 'rect', x: 0, y: 2, width: 1, height: 1, mass: 2, color: '#99ccff' });
createBody({ name: 'Body[2]', shape: 'rect', x: 0, y: -1, width: 12, height: 0.5, anchored: true, color: '#c0c0c0' });
render();
</script>
