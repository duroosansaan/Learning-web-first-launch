<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
<meta charset="UTF-8">
<title>Interactive Physics - [Experiment1.ip]</title>
<style>
  :root {
    --win-bg: #d4d0c8;
    --win-light: #ffffff;
    --win-shadow: #808080;
    --win-dark: #404040;
    --win-blue: #0a246a;
    --win-blue-grad: #a6caf0;
    --text-color: #000000;
  }

  * {
    box-sizing: border-box;
    user-select: none;
    font-family: "Tahoma", "MS Sans Serif", Arial, sans-serif;
    font-size: 11px;
  }

  body, html {
    margin: 0;
    padding: 0;
    width: 100vw;
    height: 100vh;
    overflow: hidden;
    background-color: var(--win-bg);
    display: flex;
    flex-direction: column;
  }

  /* Classic Windows 3D Borders */
  .bevel-out {
    border-top: 1px solid var(--win-light);
    border-left: 1px solid var(--win-light);
    border-right: 1px solid var(--win-dark);
    border-bottom: 1px solid var(--win-dark);
    box-shadow: inset -1px -1px 0 var(--win-shadow);
  }
  .bevel-in {
    border-top: 1px solid var(--win-shadow);
    border-left: 1px solid var(--win-shadow);
    border-right: 1px solid var(--win-light);
    border-bottom: 1px solid var(--win-light);
    box-shadow: inset 1px 1px 0 var(--win-dark);
  }

  /* Title Bar */
  #title-bar {
    background: linear-gradient(90deg, var(--win-blue), var(--win-blue-grad));
    color: white;
    font-weight: bold;
    padding: 3px 6px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: 22px;
  }
  #title-bar .title-left {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .win-btn {
    width: 16px;
    height: 14px;
    background: var(--win-bg);
    color: black;
    border-top: 1px solid var(--win-light);
    border-left: 1px solid var(--win-light);
    border-right: 1px solid var(--win-dark);
    border-bottom: 1px solid var(--win-dark);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 9px;
    font-weight: bold;
    cursor: pointer;
  }
  .win-btn:active {
    border-top: 1px solid var(--win-dark);
    border-left: 1px solid var(--win-dark);
    border-right: 1px solid var(--win-light);
    border-bottom: 1px solid var(--win-light);
  }

  /* Menu Bar */
  #menu-bar {
    background: var(--win-bg);
    display: flex;
    padding: 2px 4px;
    border-bottom: 1px solid var(--win-shadow);
    position: relative;
    z-index: 1000;
  }
  .menu-item {
    padding: 2px 7px;
    cursor: pointer;
    position: relative;
  }
  .menu-item:hover, .menu-item.active {
    background: var(--win-blue);
    color: white;
  }
  .dropdown {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    background: var(--win-bg);
    color: var(--text-color);
    min-width: 190px;
    border-top: 1px solid var(--win-light);
    border-left: 1px solid var(--win-light);
    border-right: 1px solid var(--win-dark);
    border-bottom: 1px solid var(--win-dark);
    box-shadow: 2px 2px 4px rgba(0,0,0,0.3);
    padding: 2px;
    z-index: 1001;
  }
  .menu-item.active .dropdown {
    display: block;
  }
  .dd-item {
    padding: 4px 18px 4px 12px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: pointer;
    white-space: nowrap;
  }
  .dd-item:hover {
    background: var(--win-blue);
    color: white;
  }
  .dd-sep {
    height: 1px;
    background: var(--win-shadow);
    border-bottom: 1px solid var(--win-light);
    margin: 3px 2px;
  }
  .dd-sub {
    position: relative;
  }
  .dd-sub-menu {
    display: none;
    position: absolute;
    left: 100%;
    top: -2px;
    background: var(--win-bg);
    color: black;
    min-width: 170px;
    border-top: 1px solid var(--win-light);
    border-left: 1px solid var(--win-light);
    border-right: 1px solid var(--win-dark);
    border-bottom: 1px solid var(--win-dark);
    padding: 2px;
  }
  .dd-sub:hover > .dd-sub-menu {
    display: block;
  }

  /* Toolbar */
  #toolbar {
    background: var(--win-bg);
    padding: 3px 6px;
    display: flex;
    align-items: center;
    gap: 3px;
    border-bottom: 1px solid var(--win-shadow);
    flex-wrap: wrap;
  }
  .tb-btn {
    width: 24px;
    height: 22px;
    background: var(--win-bg);
    border: 1px solid transparent;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    border-radius: 1px;
  }
  .tb-btn:hover {
    border-top: 1px solid var(--win-light);
    border-left: 1px solid var(--win-light);
    border-right: 1px solid var(--win-shadow);
    border-bottom: 1px solid var(--win-shadow);
  }
  .tb-btn.active, .tb-btn:active {
    border-top: 1px solid var(--win-shadow);
    border-left: 1px solid var(--win-shadow);
    border-right: 1px solid var(--win-light);
    border-bottom: 1px solid var(--win-light);
    background: #e4e1db;
  }
  .tb-sep {
    width: 2px;
    height: 18px;
    border-left: 1px solid var(--win-shadow);
    border-right: 1px solid var(--win-light);
    margin: 0 3px;
  }
  .sim-btn {
    padding: 2px 8px;
    height: 22px;
    background: var(--win-bg);
    border-top: 1px solid var(--win-light);
    border-left: 1px solid var(--win-light);
    border-right: 1px solid var(--win-dark);
    border-bottom: 1px solid var(--win-dark);
    display: flex;
    align-items: center;
    gap: 4px;
    cursor: pointer;
    font-weight: bold;
  }
  .sim-btn:active, .sim-btn.running {
    border-top: 1px solid var(--win-dark);
    border-left: 1px solid var(--win-dark);
    border-right: 1px solid var(--win-light);
    border-bottom: 1px solid var(--win-light);
    background: #c8c4bc;
  }

  /* Main Area */
  #main-container {
    display: flex;
    flex: 1;
    overflow: hidden;
    position: relative;
  }

  /* Left Tool Palette */
  #tool-palette {
    width: 58px;
    background: var(--win-bg);
    border-right: 1px solid var(--win-shadow);
    padding: 4px 3px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2px;
    align-content: start;
    z-index: 10;
  }
  .tool-icon {
    width: 24px;
    height: 24px;
    background: var(--win-bg);
    border: 1px solid transparent;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }
  .tool-icon:hover {
    border-top: 1px solid var(--win-light);
    border-left: 1px solid var(--win-light);
    border-right: 1px solid var(--win-shadow);
    border-bottom: 1px solid var(--win-shadow);
  }
  .tool-icon.active {
    border-top: 1px solid var(--win-dark);
    border-left: 1px solid var(--win-dark);
    border-right: 1px solid var(--win-light);
    border-bottom: 1px solid var(--win-light);
    background: #ece9d8;
  }
  .palette-sep {
    grid-column: span 2;
    height: 2px;
    border-top: 1px solid var(--win-shadow);
    border-bottom: 1px solid var(--win-light);
    margin: 3px 0;
  }

  /* Workspace */
  #workspace-wrapper {
    flex: 1;
    position: relative;
    background: #ffffff;
    overflow: hidden;
  }
  #sim-canvas {
    display: block;
    width: 100%;
    height: 100%;
    cursor: default;
  }

  /* Floating Windows (Properties, Appearance, Meters, Controls, Modals) */
  .floating-win {
    position: absolute;
    background: var(--win-bg);
    border-top: 2px solid var(--win-light);
    border-left: 2px solid var(--win-light);
    border-right: 2px solid var(--win-dark);
    border-bottom: 2px solid var(--win-dark);
    box-shadow: 2px 2px 6px rgba(0,0,0,0.35);
    z-index: 100;
    min-width: 220px;
  }
  .fw-header {
    background: linear-gradient(90deg, var(--win-blue), var(--win-blue-grad));
    color: white;
    font-weight: bold;
    padding: 2px 5px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: move;
    height: 19px;
  }
  .fw-body {
    padding: 8px;
  }
  .prop-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 5px;
    gap: 6px;
  }
  .prop-row label {
    white-space: nowrap;
  }
  .prop-input {
    width: 120px;
    background: white;
    border-top: 1px solid var(--win-shadow);
    border-left: 1px solid var(--win-shadow);
    border-right: 1px solid var(--win-light);
    border-bottom: 1px solid var(--win-light);
    padding: 2px 4px;
    font-family: "Courier New", monospace;
    font-size: 11px;
    user-select: text;
  }
  .win-action-btn {
    padding: 3px 10px;
    background: var(--win-bg);
    border-top: 1px solid var(--win-light);
    border-left: 1px solid var(--win-light);
    border-right: 1px solid var(--win-dark);
    border-bottom: 1px solid var(--win-dark);
    cursor: pointer;
  }
  .win-action-btn:active {
    border-top: 1px solid var(--win-dark);
    border-left: 1px solid var(--win-dark);
    border-right: 1px solid var(--win-light);
    border-bottom: 1px solid var(--win-light);
  }

  /* On-Canvas Controls & Meters */
  .canvas-widget {
    position: absolute;
    background: var(--win-bg);
    border-top: 1px solid var(--win-light);
    border-left: 1px solid var(--win-light);
    border-right: 1px solid var(--win-dark);
    border-bottom: 1px solid var(--win-dark);
    box-shadow: 1px 1px 3px rgba(0,0,0,0.25);
    z-index: 50;
  }
  .canvas-widget.selected {
    outline: 1px dashed #000080;
  }
  .cw-title {
    background: #808080;
    color: white;
    padding: 1px 4px;
    font-size: 10px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: move;
  }
  .canvas-widget.selected .cw-title {
    background: var(--win-blue);
  }

  /* Status Bar */
  #status-bar {
    height: 22px;
    background: var(--win-bg);
    border-top: 1px solid var(--win-light);
    display: flex;
    align-items: center;
    padding: 2px 4px;
    gap: 4px;
  }
  .status-cell {
    padding: 1px 6px;
    height: 17px;
    display: flex;
    align-items: center;
    border-top: 1px solid var(--win-shadow);
    border-left: 1px solid var(--win-shadow);
    border-right: 1px solid var(--win-light);
    border-bottom: 1px solid var(--win-light);
    background: var(--win-bg);
  }

  /* Modal Dialogs */
  #modal-backdrop {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.15);
    z-index: 2000;
    align-items: center;
    justify-content: center;
  }
  .modal-box {
    background: var(--win-bg);
    border-top: 2px solid var(--win-light);
    border-left: 2px solid var(--win-light);
    border-right: 2px solid var(--win-dark);
    border-bottom: 2px solid var(--win-dark);
    min-width: 320px;
    max-width: 500px;
    box-shadow: 4px 4px 10px rgba(0,0,0,0.4);
  }

  svg.icon {
    width: 16px;
    height: 16px;
    stroke: #000;
    fill: none;
    stroke-width: 1.5;
  }
</style>
</head>
<body>

<!-- TITLE BAR -->
<div id="title-bar">
  <div class="title-left">
    <svg width="14" height="14" viewBox="0 0 16 16">
      <rect width="16" height="16" fill="#008080"/>
      <circle cx="8" cy="8" r="5" fill="#ffff00" stroke="#000"/>
    </svg>
    <span id="window-title">Interactive Physics - [Untitled1.ip]</span>
  </div>
  <div style="display:flex; gap:2px;">
    <div class="win-btn" onclick="alert('Minimized')">_</div>
    <div class="win-btn" onclick="toggleFullScreen()">□</div>
    <div class="win-btn" onclick="if(confirm('Exit Interactive Physics?')) window.close()">×</div>
  </div>
</div>

<!-- MENU BAR -->
<div id="menu-bar">
  <!-- FILE -->
  <div class="menu-item" data-menu="file">File
    <div class="dropdown">
      <div class="dd-item" onclick="cmdNew()"><span>New</span><span>Ctrl+N</span></div>
      <div class="dd-item" onclick="cmdOpen()"><span>Open...</span><span>Ctrl+O</span></div>
      <div class="dd-item" onclick="loadWorkExperimentPreset()"><span><b>Load Work Experiment (14 Steps)</b></span><span>F2</span></div>
      <div class="dd-item" onclick="cmdNew()"><span>Close</span></div>
      <div class="dd-sep"></div>
      <div class="dd-item" onclick="cmdSave()"><span>Save</span><span>Ctrl+S</span></div>
      <div class="dd-item" onclick="cmdSaveAs()"><span>Save As...</span></div>
      <div class="dd-item" onclick="cmdRevert()"><span>Revert</span></div>
      <div class="dd-sep"></div>
      <div class="dd-item" onclick="cmdExportCSV()"><span>Export Data (.csv)...</span></div>
      <div class="dd-item" onclick="window.print()"><span>Print...</span><span>Ctrl+P</span></div>
      <div class="dd-sep"></div>
      <div class="dd-item" onclick="if(confirm('Exit?')) location.reload()"><span>Exit</span><span>Alt+F4</span></div>
    </div>
  </div>

  <!-- EDIT -->
  <div class="menu-item" data-menu="edit">Edit
    <div class="dropdown">
      <div class="dd-item" onclick="cmdUndo()"><span>Undo</span><span>Ctrl+Z</span></div>
      <div class="dd-item" onclick="cmdRedo()"><span>Redo</span><span>Ctrl+Y</span></div>
      <div class="dd-sep"></div>
      <div class="dd-item" onclick="cmdCut()"><span>Cut</span><span>Ctrl+X</span></div>
      <div class="dd-item" onclick="cmdCopy()"><span>Copy</span><span>Ctrl+C</span></div>
      <div class="dd-item" onclick="cmdPaste()"><span>Paste</span><span>Ctrl+V</span></div>
      <div class="dd-item" onclick="cmdDuplicate()"><span>Duplicate</span><span>Ctrl+D</span></div>
      <div class="dd-item" onclick="cmdDelete()"><span>Delete / Clear</span><span>Del</span></div>
      <div class="dd-sep"></div>
      <div class="dd-item" onclick="cmdSelectAll()"><span>Select All</span><span>Ctrl+A</span></div>
      <div class="dd-item" onclick="setTool('rotate')"><span>Rotate</span></div>
      <div class="dd-item" onclick="setTool('reshape')"><span>Reshape</span></div>
      <div class="dd-sep"></div>
      <div class="dd-item" onclick="openWorldModal('accuracy')"><span>Preferences...</span></div>
    </div>
  </div>

  <!-- WORLD -->
  <div class="menu-item" data-menu="world">World
    <div class="dropdown">
      <div class="dd-item" onclick="openWorldModal('gravity')"><span>Gravity...</span></div>
      <div class="dd-item" onclick="openWorldModal('air')"><span>Air Resistance...</span></div>
      <div class="dd-item" onclick="openWorldModal('electro')"><span>Electrostatics...</span></div>
      <div class="dd-item" onclick="openWorldModal('forcefield')"><span>Force Field...</span></div>
      <div class="dd-sep"></div>
      <div class="dd-item" onclick="openWorldModal('pause')"><span>Pause Control...</span></div>
      <div class="dd-item" onclick="openWorldModal('accuracy')"><span>Accuracy / Simulation Settings...</span></div>
      <div class="dd-item" onclick="toggleCollisions()"><span>Collisions</span><span id="chk-collisions">✓</span></div>
    </div>
  </div>

  <!-- VIEW -->
  <div class="menu-item" data-menu="view">View
    <div class="dropdown">
      <div class="dd-item" onclick="zoomCanvas(1.25)"><span>Zoom In</span><span>Ctrl++</span></div>
      <div class="dd-item" onclick="zoomCanvas(0.8)"><span>Zoom Out</span><span>Ctrl+-</span></div>
      <div class="dd-item" onclick="zoomToFit()"><span>Zoom to Fit</span></div>
      <div class="dd-sep"></div>
      <div class="dd-item" onclick="toggleViewFlag('grid')"><span>Grid</span><span id="chk-grid">✓</span></div>
      <div class="dd-item" onclick="toggleViewFlag('axes')"><span>Axes</span><span id="chk-axes">✓</span></div>
      <div class="dd-item" onclick="toggleViewFlag('rulers')"><span>Rulers</span><span id="chk-rulers">✓</span></div>
      <div class="dd-item" onclick="openWorldModal('units')"><span>Numbers and Units...</span></div>
      <div class="dd-sep"></div>
      <div class="dd-item" onclick="togglePalette()"><span>Toolbars & Palette</span><span>✓</span></div>
    </div>
  </div>

  <!-- OBJECT -->
  <div class="menu-item" data-menu="object">Object
    <div class="dropdown">
      <div class="dd-item" onclick="openFloatingWin('win-properties')"><span>Properties</span><span>Ctrl+I</span></div>
      <div class="dd-item" onclick="openFloatingWin('win-appearance')"><span>Appearance</span></div>
      <div class="dd-item" onclick="openFloatingWin('win-geometry')"><span>Geometry</span></div>
      <div class="dd-sep"></div>
      <div class="dd-item" onclick="setTool('rotate')"><span>Rotate</span></div>
      <div class="dd-item" onclick="cmdAnchorSelected()"><span>Anchor / Unanchor</span></div>
      <div class="dd-item" onclick="cmdJoinSelected()"><span>Join</span></div>
      <div class="dd-item" onclick="cmdSplitSelected()"><span>Split</span></div>
      <div class="dd-sep"></div>
      <div class="dd-item" onclick="cmdDuplicate()"><span>Duplicate</span></div>
      <div class="dd-item" onclick="cmdBringToFront()"><span>Bring to Front</span></div>
      <div class="dd-item" onclick="cmdSendToBack()"><span>Send to Back</span></div>
    </div>
  </div>

  <!-- DEFINE -->
  <div class="menu-item" data-menu="define">Define
    <div class="dropdown">
      <div class="dd-sub">
        <div class="dd-item"><span>New Control</span><span>▶</span></div>
        <div class="dd-sub-menu">
          <div class="dd-item" onclick="createControlForSelected('magnitude')"><span>Force Magnitude</span></div>
          <div class="dd-item" onclick="createControlForSelected('direction')"><span>Force Direction</span></div>
          <div class="dd-item" onclick="createControlForSelected('fx')"><span>Force Fx</span></div>
          <div class="dd-item" onclick="createControlForSelected('fy')"><span>Force Fy</span></div>
          <div class="dd-item" onclick="createControlForSelected('mass')"><span>Body Mass</span></div>
          <div class="dd-item" onclick="createControlForSelected('vx')"><span>Initial Velocity Vx</span></div>
          <div class="dd-item" onclick="createControlForSelected('vy')"><span>Initial Velocity Vy</span></div>
        </div>
      </div>
      <div class="dd-item" onclick="openControlPropsModal()"><span>Control Properties...</span></div>
      <div class="dd-sep"></div>
      <div class="dd-item" onclick="openFormulaEditor()"><span>Formula Editor...</span></div>
      <div class="dd-item" onclick="openVariablesList()"><span>Variables & Inputs...</span></div>
    </div>
  </div>

  <!-- MEASURE -->
  <div class="menu-item" data-menu="measure">Measure
    <div class="dropdown">
      <div class="dd-item" onclick="createMeasure('Time', 'Graph')"><span>Time</span></div>
      <div class="dd-item" onclick="createMeasure('Position', 'Graph')"><span>Position (X, Y)</span></div>
      <div class="dd-item" onclick="createMeasure('Displacement', 'Meter')"><span>Displacement</span></div>
      <div class="dd-item" onclick="createMeasure('Velocity', 'Graph')"><span>Velocity (Vx, Vy)</span></div>
      <div class="dd-item" onclick="createMeasure('Acceleration', 'Graph')"><span>Acceleration (Ax, Ay)</span></div>
      <div class="dd-item" onclick="createMeasure('Force', 'Graph')"><span>Total Force</span></div>
      <div class="dd-item" onclick="createMeasure('Momentum', 'Meter')"><span>Momentum</span></div>
      <div class="dd-sub">
        <div class="dd-item"><span>Kinetic Energy</span><span>▶</span></div>
        <div class="dd-sub-menu">
          <div class="dd-item" onclick="createMeasure('KineticEnergy', 'Graph')"><span>Translational</span></div>
          <div class="dd-item" onclick="createMeasure('RotationalKE', 'Graph')"><span>Rotational</span></div>
          <div class="dd-item" onclick="createMeasure('TotalEnergy', 'Graph')"><span>Total Energy</span></div>
        </div>
      </div>
      <div class="dd-item" onclick="createMeasure('PotentialEnergy', 'Meter')"><span>Potential Energy</span></div>
      <div class="dd-item" onclick="createMeasure('AngularVelocity', 'Meter')"><span>Angular Velocity</span></div>
      <div class="dd-item" onclick="createMeasure('Torque', 'Meter')"><span>Torque</span></div>
      <div class="dd-sep"></div>
      <div class="dd-item" onclick="createMeasure('Custom', 'Graph')"><span>Custom Graph (y1, y2)...</span></div>
      <div class="dd-item" onclick="createMeasure('Custom', 'Meter')"><span>Digital Meter...</span></div>
      <div class="dd-sub">
        <div class="dd-item"><span>Vectors</span><span>▶</span></div>
        <div class="dd-sub-menu">
          <div class="dd-item" onclick="toggleVector('vel')"><span>Velocity Vector</span></div>
          <div class="dd-item" onclick="toggleVector('acc')"><span>Acceleration Vector</span></div>
          <div class="dd-item" onclick="toggleVector('force')"><span>Force Vector</span></div>
        </div>
      </div>
    </div>
  </div>

  <!-- SCRIPT -->
  <div class="menu-item" data-menu="script">Script
    <div class="dropdown">
      <div class="dd-item" onclick="openScriptEditor()"><span>New / Edit Script...</span></div>
      <div class="dd-item" onclick="runUserScript()"><span>Run Script</span></div>
      <div class="dd-item" onclick="stopSim()"><span>Stop Script</span></div>
      <div class="dd-item" onclick="openPlotWvsThetaModal()"><span>Plot W vs θ Table & Graph...</span></div>
    </div>
  </div>

  <!-- WINDOW -->
  <div class="menu-item" data-menu="window">Window
    <div class="dropdown">
      <div class="dd-item" onclick="openFloatingWin('win-properties')"><span>Properties</span></div>
      <div class="dd-item" onclick="openFloatingWin('win-appearance')"><span>Appearance</span></div>
      <div class="dd-item" onclick="openFloatingWin('win-geometry')"><span>Geometry</span></div>
      <div class="dd-sep"></div>
      <div class="dd-item" onclick="cascadeWindows()"><span>Cascade Windows</span></div>
      <div class="dd-item" onclick="closeAllFloating()"><span>Close Floating Windows</span></div>
    </div>
