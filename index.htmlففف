<script>
/**
 * ============================================================================
 * INTERACTIVE PHYSICS - COMPLETE WEB ENGINE
 * ============================================================================
 */

// --- SIMULATION & WORLD STATE ---
const state = {
  running: false,
  time: 0,
  frame: 0,
  accuracyFPS: 100, // World -> Accuracy (default 100 f/s as in step 11)
  decimalDigits: 2, // View -> Numbers and Units (0 digits in step 9)
  gravity: { enabled: true, x: 0, y: -9.8, mode: 'vertical' },
  airResistance: { enabled: false, k: 0.05 },
  electrostatics: { enabled: false, k: 8.99e9 },
  forceField: { enabled: false, fx: 0, fy: 0 },
  collisionsEnabled: true,
  pauseConditions: [], // e.g., ["Body[1].P.X>=3", "Body[1].P.X<=-3"]
  view: {
    zoom: 60, // pixels per meter
    panX: 0,
    panY: 0,
    grid: true,
    axes: true,
    rulers: true,
    vectors: { vel: false, acc: false, force: true }
  },
  tool: 'select',
  bodies: [],
  forces: [],
  constraints: [], // pin, rod, spring, rope, motor
  controls: [],    // Input[1], Input[2]...
  meters: [],      // Measure boxes & graphs
  texts: [],
  selected: null,  // { type: 'body'|'force'|'constraint'|'control'|'meter', id: number }
  clipboard: null,
  history: [],
  redoStack: [],
  userScript: "// Example Script:\n// Body[1].V.X = 2;\n// runSim();"
};

let nextId = { body: 1, force: 1, constraint: 1, control: 1, meter: 1, text: 1 };
let initialSnapshot = null;

// Canvas setup
const canvas = document.getElementById('sim-canvas');
const ctx = canvas.getContext('2d');
const wrapper = document.getElementById('workspace-wrapper');

function resizeCanvas() {
  canvas.width = wrapper.clientWidth;
  canvas.height = wrapper.clientHeight;
  render();
}
window.addEventListener('resize', resizeCanvas);

// Coordinate conversions (World Meters <-> Screen Pixels)
function worldToScreen(wx, wy) {
  const cx = canvas.width / 2 + state.view.panX;
  const cy = canvas.height / 2 + state.view.panY;
  return {
    x: cx + wx * state.view.zoom,
    y: cy - wy * state.view.zoom
  };
}
function screenToWorld(sx, sy) {
  const cx = canvas.width / 2 + state.view.panX;
  const cy = canvas.height / 2 + state.view.panY;
  return {
    x: (sx - cx) / state.view.zoom,
    y: (cy - sy) / state.view.zoom
  };
}

// --- FORMULA & EXPRESSION EVALUATOR (Interactive Physics Syntax) ---
// Supports: Body[1].P.X, Body[1].V.X, ConstraintForce[1], Input[1], sin, cos, pi, abs()
function evaluateFormula(expr, contextObj = null) {
  if (typeof expr === 'number') return expr;
  if (!expr || String(expr).trim() === '') return 0;
  let str = String(expr).trim();

  // Replace |...| absolute value bars (like |ConstraintForce[1]|)
  str = str.replace(/\|([^|]+)\|/g, 'Math.abs($1)');

  // Replace constants & trig
  str = str.replace(/\bpi\b/gi, 'Math.PI');
  str = str.replace(/\bcos\s*\(/gi, 'Math.cos(');
  str = str.replace(/\bsin\s*\(/gi, 'Math.sin(');
  str = str.replace(/\btan\s*\(/gi, 'Math.tan(');
  str = str.replace(/\bsqrt\s*\(/gi, 'Math.sqrt(');
  str = str.replace(/\babs\s*\(/gi, 'Math.abs(');
  str = str.replace(/\bt\b/g, String(state.time));

  // Replace Input[n]
  str = str.replace(/Input\[(\d+)\]/gi, (_, id) => {
    const ctrl = state.controls.find(c => c.id === parseInt(id));
    return ctrl ? ctrl.value : 0;
  });

  // Replace ConstraintForce[n] or Force[n]
  str = str.replace(/(?:ConstraintForce|Force)\[(\d+)\]/gi, (_, id) => {
    const f = state.forces.find(item => item.id === parseInt(id));
    if (!f) return 0;
    return Math.hypot(f.fx, f.fy);
  });

  // Replace Body[n].Prop.SubProp
  str = str.replace(/Body\[(\d+)\]\.([A-Za-z0-9_.]+)/gi, (_, id, propPath) => {
    const b = state.bodies.find(item => item.id === parseInt(id));
    if (!b) return 0;
    const p = propPath.toUpperCase();
    if (p === 'P.X' || p === 'X') return b.x;
    if (p === 'P.Y' || p === 'Y') return b.y;
    if (p === 'V.X' || p === 'VX') return b.vx;
    if (p === 'V.Y' || p === 'VY') return b.vy;
    if (p === 'V') return Math.hypot(b.vx, b.vy);
    if (p === 'A.X' || p === 'AX') return b.ax;
    if (p === 'A.Y' || p === 'AY') return b.ay;
    if (p === 'A') return Math.hypot(b.ax, b.ay);
    if (p === 'M' || p === 'MASS') return b.mass;
    if (p === 'KE') return 0.5 * b.mass * (b.vx * b.vx + b.vy * b.vy);
    return 0;
  });

  try {
    // Evaluate safely
    const fn = new Function('return (' + str + ');');
    const res = fn();
    return isNaN(res) ? 0 : res;
  } catch (e) {
    return 0;
  }
}

function evaluateCondition(condStr) {
  if (!condStr || !condStr.trim()) return false;
  // Convert >=, <=, =, >, <
  let parts = condStr.match(/^(.+?)(>=|<=|==|=|>|<)(.+)$/);
  if (!parts) return false;
  const lhs = evaluateFormula(parts[1]);
  const op = parts[2];
  const rhs = evaluateFormula(parts[3]);
  switch (op) {
    case '>=': return lhs >= rhs;
    case '<=': return lhs <= rhs;
    case '>': return lhs > rhs;
    case '<': return lhs < rhs;
    case '=':
    case '==': return Math.abs(lhs - rhs) < 1e-4;
    default: return false;
  }
}

// --- OBJECT FACTORIES ---
function createBody(opts) {
  const id = nextId.body++;
  const body = {
    id,
    name: opts.name || `Body[${id}]`,
    shape: opts.shape || 'rect', // 'circle', 'rect', 'polygon', 'point'
    x: opts.x ?? 0,
    y: opts.y ?? 0,
    vx: opts.vx ?? 0,
    vy: opts.vy ?? 0,
    ax: 0,
    ay: 0,
    angle: opts.angle ?? 0,
    omega: opts.omega ?? 0,
    mass: opts.mass ?? 1.0,
    massFormula: opts.massFormula || null,
    vxFormula: opts.vxFormula || null,
    vyFormula: opts.vyFormula || null,
    width: opts.width ?? 1.0,
    height: opts.height ?? 1.0,
    radius: opts.radius ?? 0.5,
    points: opts.points || [],
    staticFriction: opts.staticFriction ?? 0.3,
    kineticFriction: opts.kineticFriction ?? 0.2,
    elasticity: opts.elasticity ?? 0.5,
    charge: opts.charge ?? 0,
    anchored: opts.anchored ?? false,
    color: opts.color || (opts.anchored ? '#c0c0c0' : '#99ccff'),
    borderColor: opts.borderColor || '#000000',
    visible: true,
    trail: []
  };
  state.bodies.push(body);
  return body;
}

function createForce(opts) {
  const id = nextId.force++;
  const force = {
    id,
    name: `ConstraintForce[${id}]`,
    bodyId: opts.bodyId,
    offsetX: opts.offsetX ?? 0,
    offsetY: opts.offsetY ?? 0,
    isPolar: opts.isPolar ?? false,
    fx: opts.fx ?? 10,
    fy: opts.fy ?? 0,
    mag: opts.mag ?? 10,
    dir: opts.dir ?? 0, // stored in radians internally or evaluated via formula
    fxFormula: opts.fxFormula || null,
    fyFormula: opts.fyFormula || null,
    magFormula: opts.magFormula || null,
    dirFormula: opts.dirFormula || null,
    color: '#cc0000'
  };
  updateForceComponents(force);
  state.forces.push(force);
  return force;
}

function updateForceComponents(f) {
  // Sync controls linked to this force first
  state.controls.forEach(c => {
    if (c.targetType === 'force' && c.targetId === f.id) {
      if (c.prop === 'magnitude' && !f.magFormula) f.mag = parseFloat(c.value) || 0;
      if (c.prop === 'direction' && !f.dirFormula) f.dir = parseFloat(c.value) || 0;
      if (c.prop === 'fx' && !f.fxFormula) f.fx = parseFloat(c.value) || 0;
      if (c.prop === 'fy' && !f.fyFormula) f.fy = parseFloat(c.value) || 0;
    }
  });

  if (f.isPolar) {
    const m = f.magFormula ? evaluateFormula(f.magFormula) : f.mag;
    const d = f.dirFormula ? evaluateFormula(f.dirFormula) : f.dir;
    f.mag = m;
    f.dir = d;
    f.fx = m * Math.cos(d);
    f.fy = m * Math.sin(d);
  } else {
    f.fx = f.fxFormula ? evaluateFormula(f.fxFormula) : f.fx;
    f.fy = f.fyFormula ? evaluateFormula(f.fyFormula) : f.fy;
    f.mag = Math.hypot(f.fx, f.fy);
    f.dir = Math.atan2(f.fy, f.fx);
  }
}

// --- PHYSICS ENGINE STEP ---
function stepPhysics(dt) {
  // 1. Evaluate dynamic formulas on controls/bodies/forces
  state.bodies.forEach(b => {
    if (b.massFormula) b.mass = Math.max(0.01, evaluateFormula(b.massFormula));
    if (state.time === 0) {
      if (b.vxFormula) b.vx = evaluateFormula(b.vxFormula);
      if (b.vyFormula) b.vy = evaluateFormula(b.vyFormula);
    }
  });
  state.forces.forEach(updateForceComponents);

  // 2. Accumulate forces per body
  const netF = new Map();
  state.bodies.forEach(b => netF.set(b.id, { fx: 0, fy: 0, torque: 0 }));

  // Gravity & Force Field & Air Resistance
  state.bodies.forEach(b => {
    if (b.anchored || b.shape === 'point') return;
    const f = netF.get(b.id);
    if (state.gravity.enabled) {
      f.fx += b.mass * state.gravity.x;
      f.fy += b.mass * state.gravity.y;
    }
    if (state.forceField.enabled) {
      f.fx += state.forceField.fx;
      f.fy += state.forceField.fy;
    }
    if (state.airResistance.enabled) {
      f.fx -= state.airResistance.k * b.vx;
      f.fy -= state.airResistance.k * b.vy;
    }
  });

  // Applied Forces
  state.forces.forEach(force => {
    const b = state.bodies.find(item => item.id === force.bodyId);
    if (b && !b.anchored) {
      const f = netF.get(b.id);
      f.fx += force.fx;
      f.fy += force.fy;
    }
  });

  // Constraints (Springs, Rods, Pins, Motors)
  state.constraints.forEach(c => {
    const b1 = state.bodies.find(b => b.id === c.b1);
    const b2 = c.b2 ? state.bodies.find(b => b.id === c.b2) : null;
    if (!b1) return;

    const p1x = b1.x + (c.off1x || 0);
    const p1y = b1.y + (c.off1y || 0);
    const p2x = b2 ? b2.x + (c.off2x || 0) : c.wx;
    const p2y = b2 ? b2.y + (c.off2y || 0) : c.wy;

    const dx = p2x - p1x;
    const dy = p2y - p1y;
    const dist = Math.hypot(dx, dy) || 1e-6;
    const nx = dx / dist;
    const ny = dy / dist;

    if (c.type === 'spring') {
      const stretch = dist - c.restLength;
      const k = c.stiffness || 20;
      const damp = c.damping || 0.5;
      const rvx = (b2 ? b2.vx : 0) - b1.vx;
      const rvy = (b2 ? b2.vy : 0) - b1.vy;
      const fMag = k * stretch + damp * (rvx * nx + rvy * ny);
      if (!b1.anchored) { netF.get(b1.id).fx += fMag * nx; netF.get(b1.id).fy += fMag * ny; }
      if (b2 && !b2.anchored) { netF.get(b2.id).fx -= fMag * nx; netF.get(b2.id).fy -= fMag * ny; }
    } else if (c.type === 'rod' || c.type === 'rope') {
      if (c.type === 'rope' && dist <= c.restLength) return;
      const stretch = dist - c.restLength;
      const k = 1500;
      const fMag = k * stretch;
      if (!b1.anchored) { netF.get(b1.id).fx += fMag * nx; netF.get(b1.id).fy += fMag * ny; }
      if (b2 && !b2.anchored) { netF.get(b2.id).fx -= fMag * nx; netF.get(b2.id).fy -= fMag * ny; }
    } else if (c.type === 'pin') {
      const k = 2000;
      if (!b1.anchored) { netF.get(b1.id).fx += k * dx; netF.get(b1.id).fy += k * dy; }
      if (b2 && !b2.anchored) { netF.get(b2.id).fx -= k * dx; netF.get(b2.id).fy -= k * dy; }
    } else if (c.type === 'motor') {
      if (!b1.anchored) b1.omega = c.speed || 2.0;
    }
  });

  // 3. Semi-Implicit Euler Integration
  state.bodies.forEach(b => {
    if (b.anchored || b.shape === 'point') {
      b.vx = 0; b.vy = 0; b.ax = 0; b.ay = 0;
      return;
    }
    const f = netF.get(b.id);
    b.ax = f.fx / b.mass;
    b.ay = f.fy / b.mass;
    b.vx += b.ax * dt;
    b.vy += b.ay * dt;
    b.x += b.vx * dt;
    b.y += b.vy * dt;
    b.angle += b.omega * dt;
  });

  // 4. Collisions & Friction Resolution
  if (state.collisionsEnabled) {
    resolveCollisions(dt);
  }

  // Advance Time
  state.time += dt;
  state.frame++;

  // Record Data in Meters / Graphs
  recordMeters();

  // 5. Check Pause Control Conditions
  for (let cond of state.pauseConditions) {
    if (evaluateCondition(cond)) {
      stopSim();
      setStatus(`Simulation paused: condition "${cond}" met at t = ${formatNum(state.time)} s.`);
      break;
    }
  }
}

function getBodyBounds(b) {
  if (b.shape === 'circle') {
    return { minX: b.x - b.radius, maxX: b.x + b.radius, minY: b.y - b.radius, maxY: b.y + b.radius };
  }
  return { minX: b.x - b.width / 2, maxX: b.x + b.width / 2, minY: b.y - b.height / 2, maxY: b.y + b.height / 2 };
}

function resolveCollisions(dt) {
  for (let i = 0; i < state.bodies.length; i++) {
    for (let j = i + 1; j < state.bodies.length; j++) {
      const A = state.bodies[i];
      const B = state.bodies[j];
      if (A.shape === 'point' || B.shape === 'point') continue;
      if (A.anchored && B.anchored) continue;

      const bA = getBodyBounds(A);
      const bB = getBodyBounds(B);

      const overlapX = Math.min(bA.maxX, bB.maxX) - Math.max(bA.minX, bB.minX);
      const overlapY = Math.min(bA.maxY, bB.maxY) - Math.max(bA.minY, bB.minY);

      if (overlapX > 0 && overlapY > 0) {
        const e = Math.min(A.elasticity, B.elasticity);
        const mu = Math.max(A.kineticFriction, B.kineticFriction);
        const invMassA = A.anchored ? 0 : 1 / A.mass;
        const invMassB = B.anchored ? 0 : 1 / B.mass;
        const invMassSum = invMassA + invMassB;
        if (invMassSum === 0) continue;

        if (overlapY < overlapX) {
          // Vertical collision
          const dir = A.y > B.y ? 1 : -1;
          const corr = overlapY / invMassSum;
          if (!A.anchored) A.y += dir * corr * invMassA;
          if (!B.anchored) B.y -= dir * corr * invMassB;

          const rvy = A.vy - B.vy;
          if (rvy * dir < 0) {
            const jImp = -(1 + e) * rvy / invMassSum;
            if (!A.anchored) A.vy += jImp * invMassA;
            if (!B.anchored) B.vy -= jImp * invMassB;

            // Friction along X
            const normalForce = Math.abs(jImp) / dt;
            const rvx = A.vx - B.vx;
            if (Math.abs(rvx) > 1e-5 && mu > 0) {
              const fMax = mu * normalForce * dt;
              const fImp = Math.sign(rvx) * Math.min(Math.abs(rvx) / invMassSum, fMax);
              if (!A.anchored) A.vx -= fImp * invMassA;
              if (!B.anchored) B.vx += fImp * invMassB;
            }
          }
        } else {
          // Horizontal collision
          const dir = A.x > B.x ? 1 : -1;
          const corr = overlapX / invMassSum;
          if (!A.anchored) A.x += dir * corr * invMassA;
          if (!B.anchored) B.x -= dir * corr * invMassB;

          const rvx = A.vx - B.vx;
          if (rvx * dir < 0) {
            const jImp = -(1 + e) * rvx / invMassSum;
            if (!A.anchored) A.vx += jImp * invMassA;
            if (!B.anchored) B.vx -= jImp * invMassB;
          }
        }
      }
    }
  }
}

// --- SIMULATION LOOP ---
let rafId = null;
function runSim() {
  if (state.running) return;
  if (state.time === 0) {
    initialSnapshot = JSON.stringify({
      bodies: state.bodies,
      forces: state.forces,
      constraints: state.constraints
    });
  }
  state.running = true;
  document.getElementById('btn-run').classList.add('running');
  setStatus('Running simulation...');

  function loop() {
    if (!state.running) return;
    const dt = 1 / state.accuracyFPS;
    // Run substeps to match real-time ~60fps visual
    const stepsPerFrame = Math.max(1, Math.round(state.accuracyFPS / 60));
    for (let s = 0; s < stepsPerFrame; s++) {
      if (!state.running) break;
      stepPhysics(dt);
    }
    updateUIReadouts();
    render();
    rafId = requestAnimationFrame(loop);
  }
  rafId = requestAnimationFrame(loop);
}

function stopSim() {
  state.running = false;
  document.getElementById('btn-run').classList.remove('running');
  if (rafId) cancelAnimationFrame(rafId);
  updateUIReadouts();
  render();
  setStatus('Simulation stopped.');
}

function resetSim() {
  stopSim();
  state.time = 0;
  state.frame = 0;
  if (initialSnapshot) {
    const snap = JSON.parse(initialSnapshot);
    state.bodies = snap.bodies;
    state.forces = snap.forces;
    state.constraints = snap.constraints;
  }
  state.meters.forEach(m => {
    m.data = [];
    m.val1 = 0;
    m.val2 = 0;
  });
  state.forces.forEach(updateForceComponents);
  updateUIReadouts();
  renderPropertiesWindow();
  render();
  setStatus('Reset to initial state (t = 0.00 s).');
}

// --- RENDERING ENGINE ---
function render() {
  const w = canvas.width;
  const h = canvas.height;
  ctx.clearRect(0, 0, w, h);

  // 1. Grid
  if (state.view.grid) {
    drawGrid(w, h);
  }

  // 2. Axes
  if (state.view.axes) {
    drawAxes(w, h);
  }

  // 3. Bodies
  state.bodies.forEach(b => {
    if (!b.visible) return;
    drawBody(b);
  });

  // 4. Constraints (Springs, Rods, Pins)
  state.constraints.forEach(c => drawConstraint(c));

  // 5. Forces & Vectors
  state.forces.forEach(f => drawForce(f));

  // 6. Velocity / Acceleration Vectors
  state.bodies.forEach(b => {
    if (!b.visible || b.anchored) return;
    const pos = worldToScreen(b.x, b.y);
    if (state.view.vectors.vel && Math.hypot(b.vx, b.vy) > 0.01) {
      drawArrow(pos.x, pos.y, pos.x + b.vx * 25, pos.y - b.vy * 25, '#008000', 'V');
    }
    if (state.view.vectors.acc && Math.hypot(b.ax, b.ay) > 0.01) {
      drawArrow(pos.x, pos.y, pos.x + b.ax * 15, pos.y - b.ay * 15, '#0000cc', 'A');
    }
  });

  // 7. Text Annotations
  state.texts.forEach(t => {
    const pos = worldToScreen(t.x, t.y);
    ctx.fillStyle = t.color || '#000';
    ctx.font = 'bold 12px Tahoma';
    ctx.fillText(t.text, pos.x, pos.y);
  });

  // 8. Rulers
  if (state.view.rulers) {
    drawRulers(w, h);
  }

  // 9. Active Drawing Preview
  if (dragDraw) {
    drawCreationPreview();
  }
}

function drawGrid(w, h) {
  const stepPx = state.view.zoom; // 1 meter grid
  const origin = worldToScreen(0, 0);
  ctx.strokeStyle = '#e6e6e6';
  ctx.lineWidth = 1;
  ctx.beginPath();
  for (let x = origin.x % stepPx; x < w; x += stepPx) {
    ctx.moveTo(x, 0); ctx.lineTo(x, h);
  }
  for (let y = origin.y % stepPx; y < h; y += stepPx) {
    ctx.moveTo(0, y); ctx.lineTo(w, y);
  }
  ctx.stroke();
}

function drawAxes(w, h) {
  const origin = worldToScreen(0, 0);
  ctx.strokeStyle = '#808080';
  ctx.lineWidth = 1.5;
  ctx.beginPath();
  ctx.moveTo(0, origin.y); ctx.lineTo(w, origin.y);
  ctx.moveTo(origin.x, 0); ctx.lineTo(origin.x, h);
  ctx.stroke();

  // Tick marks & numbers
  ctx.fillStyle = '#555';
  ctx.font = '10px Tahoma';
  const step = state.view.zoom;
  for (let i = -20; i <= 20; i++) {
    if (i === 0) continue;
    const px = origin.x + i * step;
    if (px > 20 && px < w - 10) {
      ctx.beginPath(); ctx.moveTo(px, origin.y - 3); ctx.lineTo(px, origin.y + 3); ctx.stroke();
      ctx.fillText(i, px - 4, origin.y + 13);
    }
    const py = origin.y - i * step;
    if (py > 20 && py < h - 10) {
      ctx.beginPath(); ctx.moveTo(origin.x - 3, py); ctx.lineTo(origin.x + 3, py); ctx.stroke();
      ctx.fillText(i, origin.x + 6, py + 3);
    }
  }
}

function drawRulers(w, h) {
  const origin = worldToScreen(0, 0);
  ctx.fillStyle = '#f0f0f0';
  ctx.fillRect(0, 0, w, 16);
  ctx.fillRect(0, 0, 18, h);
  ctx.strokeStyle = '#808080';
  ctx.strokeRect(0, 0, w, 16);
  ctx.strokeRect(0, 0, 18, h);

  ctx.fillStyle = '#000';
  ctx.font = '9px Tahoma';
  const step = state.view.zoom;
  for (let i = -30; i <= 30; i++) {
    const px = origin.x + i * step;
    if (px > 18 && px < w) {
      ctx.beginPath(); ctx.moveTo(px, 10); ctx.lineTo(px, 16); ctx.stroke();
      ctx.fillText(i, px + 2, 10);
    }
    const py = origin.y - i * step;
    if (py > 16 && py < h) {
      ctx.beginPath(); ctx.moveTo(12, py); ctx.lineTo(18, py); ctx.stroke();
      ctx.fillText(i, 2, py - 2);
    }
  }
}

function drawBody(b) {
  const pos = worldToScreen(b.x, b.y);
  const isSel = state.selected && state.selected.type === 'body' && state.selected.id === b.id;

  ctx.save();
  ctx.translate(pos.x, pos.y);
  ctx.rotate(-b.angle);

  ctx.fillStyle = b.color;
  ctx.strokeStyle = isSel ? '#0000ff' : b.borderColor;
  ctx.lineWidth = isSel ? 2 : 1.2;

  if (b.shape === 'circle') {
    const rPx = b.radius * state.view.zoom;
    ctx.beginPath();
    ctx.arc(0, 0, rPx, 0, Math.PI * 2);
    ctx.fill();
    ctx.stroke();
    // Radius line to visualize rotation
    ctx.beginPath(); ctx.moveTo(0, 0); ctx.lineTo(rPx, 0); ctx.stroke();
  } else if (b.shape === 'rect') {
    const wPx = b.width * state.view.zoom;
    const hPx = b.height * state.view.zoom;
    ctx.fillRect(-wPx / 2, -hPx / 2, wPx, hPx);
    ctx.strokeRect(-wPx / 2, -hPx / 2, wPx, hPx);
  } else if (b.shape === 'polygon' && b.points.length > 2) {
    ctx.beginPath();
    b.points.forEach((pt, idx) => {
      const px = pt.x * state.view.zoom;
      const py = -pt.y * state.view.zoom;
      if (idx === 0) ctx.moveTo(px, py);
      else ctx.lineTo(px, py);
    });
    ctx.closePath();
    ctx.fill();
    ctx.stroke();
  } else if (b.shape === 'point') {
    ctx.beginPath();
    ctx.arc(0, 0, 3, 0, Math.PI * 2);
    ctx.fillStyle = '#000';
    ctx.fill();
  }

  // Draw Anchor icon if anchored
  if (b.anchored) {
    ctx.strokeStyle = '#333';
    ctx.lineWidth = 1.2;
    ctx.beginPath();
    ctx.moveTo(-5, 0); ctx.lineTo(5, 0);
    ctx.moveTo(0, -5); ctx.lineTo(0, 5);
    ctx.stroke();
    ctx.strokeRect(-4, -4, 8, 8);
  }

  // Selection handles
  if (isSel) {
    ctx.fillStyle = '#000';
    const hw = (b.shape === 'circle' ? b.radius : b.width / 2) * state.view.zoom;
    const hh = (b.shape === 'circle' ? b.radius : b.height / 2) * state.view.zoom;
    [[-hw, -hh], [hw, -hh], [-hw, hh], [hw, hh]].forEach(([hx, hy]) => {
      ctx.fillRect(hx - 3, hy - 3, 6, 6);
    });
  }

  ctx.restore();
}

function drawConstraint(c) {
  const b1 = state.bodies.find(b => b.id === c.b1);
  if (!b1) return;
  const p1 = worldToScreen(b1.x + (c.off1x || 0), b1.y + (c.off1y || 0));
  const b2 = c.b2 ? state.bodies.find(b => b.id === c.b2) : null;
  const p2 = b2 ? worldToScreen(b2.x + (c.off2x || 0), b2.y + (c.off2y || 0)) : worldToScreen(c.wx, c.wy);

  ctx.save();
  ctx.strokeStyle = '#333';
  ctx.lineWidth = 1.5;

  if (c.type === 'pin') {
    ctx.fillStyle = '#fff';
    ctx.beginPath(); ctx.arc(p1.x, p1.y, 4, 0, Math.PI * 2); ctx.fill(); ctx.stroke();
  } else if (c.type === 'rod') {
    ctx.beginPath(); ctx.moveTo(p1.x, p1.y); ctx.lineTo(p2.x, p2.y); ctx.stroke();
    ctx.fillStyle = '#fff';
    ctx.beginPath(); ctx.arc(p1.x, p1.y, 3, 0, Math.PI * 2); ctx.fill(); ctx.stroke();
    ctx.beginPath(); ctx.arc(p2.x, p2.y, 3, 0, Math.PI * 2); ctx.fill(); ctx.stroke();
  } else if (c.type === 'rope') {
    ctx.setLineDash([4, 3]);
    ctx.beginPath(); ctx.moveTo(p1.x, p1.y); ctx.lineTo(p2.x, p2.y); ctx.stroke();
  } else if (c.type === 'spring') {
    const dx = p2.x - p1.x;
    const dy = p2.y - p1.y;
    const len = Math.hypot(dx, dy);
    const ang = Math.atan2(dy, dx);
    ctx.translate(p1.x, p1.y);
    ctx.rotate(ang);
    ctx.beginPath();
    ctx.moveTo(0, 0);
    const coils = 10;
    for (let i = 1; i < coils; i++) {
      const x = (i / coils) * len;
      const y = (i % 2 === 0 ? -6 : 6);
      ctx.lineTo(x, y);
    }
    ctx.lineTo(len, 0);
    ctx.stroke();
  } else if (c.type === 'motor') {
    ctx.fillStyle = '#eee';
    ctx.beginPath(); ctx.arc(p1.x, p1.y, 8, 0, Math.PI * 2); ctx.fill(); ctx.stroke();
    ctx.fillStyle = '#000';
    ctx.font = 'bold 9px Tahoma';
    ctx.fillText('M', p1.x - 4, p1.y + 3);
  }
  ctx.restore();
}

function drawForce(f) {
  const b = state.bodies.find(item => item.id === f.bodyId);
  if (!b) return;
  const start = worldToScreen(b.x + f.offsetX, b.y + f.offsetY);
  const scale = 6; // pixels per Newton
  const endX = start.x + f.fx * scale;
  const endY = start.y - f.fy * scale;
  const isSel = state.selected && state.selected.type === 'force' && state.selected.id === f.id;

  drawArrow(start.x, start.y, endX, endY, isSel ? '#0000ff' : f.color, `F[${f.id}]`);
}

function drawArrow(x1, y1, x2, y2, color, label) {
  const ang = Math.atan2(y2 - y1, x2 - x1);
  const headLen = 10;
  ctx.save();
  ctx.strokeStyle = color;
  ctx.fillStyle = color;
  ctx.lineWidth = 2;
  ctx.beginPath();
  ctx.moveTo(x1, y1);
  ctx.lineTo(x2, y2);
  ctx.stroke();

  ctx.beginPath();
  ctx.moveTo(x2, y2);
  ctx.lineTo(x2 - headLen * Math.cos(ang - Math.PI / 6), y2 - headLen * Math.sin(ang - Math.PI / 6));
  ctx.lineTo(x2 - headLen * Math.cos(ang + Math.PI / 6), y2 - headLen * Math.sin(ang + Math.PI / 6));
  ctx.closePath();
  ctx.fill();

  if (label) {
    ctx.font = 'bold 10px Tahoma';
    ctx.fillText(label, x2 + 5, y2 - 5);
  }
  ctx.restore();
}

// --- CANVAS INTERACTION (MOUSE EVENTS) ---
let isDragging = false;
let dragOffset = { x: 0, y: 0 };
let dragDraw = null;
let polyPoints = [];

canvas.addEventListener('mousedown', (e) => {
  closeAllMenus();
  const rect = canvas.getBoundingClientRect();
  const sx = e.clientX - rect.left;
  const sy = e.clientY - rect.top;
  const wPos = screenToWorld(sx, sy);

  if (state.tool === 'select') {
    const hit = hitTest(sx, sy, wPos);
    state.selected = hit;
    renderPropertiesWindow();
    renderAppearanceWindow();
    renderGeometryWindow();
    if (hit && hit.type === 'body') {
      const b = state.bodies.find(item => item.id === hit.id);
      isDragging = true;
      dragOffset = { x: wPos.x - b.x, y: wPos.y - b.y };
    } else if (!hit) {
      // Pan workspace with middle click or empty drag
      isDragging = true;
      dragOffset = { x: sx - state.view.panX, y: sy - state.view.panY, pan: true };
    }
    render();
  } else if (state.tool === 'zoom') {
    zoomCanvas(e.shiftKey ? 0.8 : 1.25);
  } else if (state.tool === 'text') {
    const txt = prompt('Enter label text:', 'Label');
    if (txt) {
      state.texts.push({ id: nextId.text++, x: wPos.x, y: wPos.y, text: txt });
      setTool('select');
      render();
    }
  } else if (state.tool === 'point') {
    const b = createBody({ shape: 'point', x: wPos.x, y: wPos.y, mass: 0 });
    selectObject('body', b.id);
    setTool('select');
  } else if (state.tool === 'anchor') {
    const hit = hitTest(sx, sy, wPos);
    if (hit && hit.type === 'body') {
      const b = state.bodies.find(item => item.id === hit.id);
      b.anchored = !b.anchored;
      b.color = b.anchored ? '#c0c0c0' : '#99ccff';
      renderPropertiesWindow();
      render();
    }
    setTool('select');
  } else if (['circle', 'rect', 'square', 'force', 'spring', 'rod', 'rope'].includes(state.tool)) {
    dragDraw = { tool: state.tool, x1: wPos.x, y1: wPos.y, x2: wPos.x, y2: wPos.y };
  } else if (state.tool === 'polygon') {
    polyPoints.push({ x: wPos.x, y: wPos.y });
    render();
  } else if (state.tool === 'pin' || state.tool === 'motor') {
    const hit = hitTest(sx, sy, wPos);
    if (hit && hit.type === 'body') {
      const b = state.bodies.find(item => item.id === hit.id);
      state.constraints.push({
        type: state.tool,
        b1: b.id,
        off1x: wPos.x - b.x,
        off1y: wPos.y - b.y,
        wx: wPos.x,
        wy: wPos.y,
        speed: 2.0
      });
      setTool('select');
      render();
    }
  } else if (state.tool === 'rotate') {
    const hit = hitTest(sx, sy, wPos);
    if (hit && hit.type === 'body') {
      selectObject('body', hit.id);
      isDragging = true;
      dragOffset = { rotate: true };
    }
  }
});

canvas.addEventListener('mousemove', (e) => {
  const rect = canvas.getBoundingClientRect();
  const sx = e.clientX - rect.left;
  const sy = e.clientY - rect.top;
  const wPos = screenToWorld(sx, sy);

  document.getElementById('status-coords').textContent =
    `X: ${formatNum(wPos.x)} m  Y: ${formatNum(wPos.y)} m`;

  if (isDragging && state.tool === 'select') {
    if (dragOffset.pan) {
      state.view.panX = sx - dragOffset.x;
      state.view.panY = sy - dragOffset.y;
    } else if (state.selected && state.selected.type === 'body') {
      const b = state.bodies.find(item => item.id === state.selected.id);
      if (b) {
        b.x = wPos.x - dragOffset.x;
        b.y = wPos.y - dragOffset.y;
        renderPropertiesWindow();
      }
    }
    render();
  } else if (isDragging && state.tool === 'rotate' && state.selected?.type === 'body') {
    const b = state.bodies.find(item => item.id === state.selected.id);
    if (b) {
      b.angle = Math.atan2(wPos.y - b.y, wPos.x - b.x);
      render();
    }
  } else if (dragDraw) {
    dragDraw.x2 = wPos.x;
    dragDraw.y2 = wPos.y;
    render();
  }
});

canvas.addEventListener('mouseup', (e) => {
  if (isDragging) {
    isDragging = false;
    dragOffset = {};
  }
  if (dragDraw) {
    finishDragDraw();
    dragDraw = null;
    render();
  }
});

canvas.addEventListener('dblclick', (e) => {
  if (state.tool === 'polygon' && polyPoints.length >= 3) {
    const cx = polyPoints.reduce((s, p) => s + p.x, 0) / polyPoints.length;
    const cy = polyPoints.reduce((s, p) => s + p.y, 0) / polyPoints.length;
    const localPts = polyPoints.map(p => ({ x: p.x - cx, y: p.y - cy }));
    const b = createBody({ shape: 'polygon', x: cx, y: cy, points: localPts, width: 1.5, height: 1.5 });
    polyPoints = [];
    selectObject('body', b.id);
    setTool('select');
    render();
  } else if (state.selected) {
    openFloatingWin('win-properties');
  }
});

function drawCreationPreview() {
  const p1 = worldToScreen(dragDraw.x1, dragDraw.y1);
  const p2 = worldToScreen(dragDraw.x2, dragDraw.y2);
  ctx.save();
  ctx.strokeStyle = '#0000ff';
  ctx.setLineDash([3, 3]);
  if (dragDraw.tool === 'circle') {
    const r = Math.hypot(p2.x - p1.x, p2.y - p1.y);
    ctx.beginPath(); ctx.arc(p1.x, p1.y, r, 0, Math.PI * 2); ctx.stroke();
  } else if (dragDraw.tool === 'rect' || dragDraw.tool === 'square') {
    const w = p2.x - p1.x;
    const h = dragDraw.tool === 'square' ? Math.sign(p2.y - p1.y) * Math.abs(w) : (p2.y - p1.y);
    ctx.strokeRect(p1.x, p1.y, w, h);
  } else {
    ctx.beginPath(); ctx.moveTo(p1.x, p1.y); ctx.lineTo(p2.x, p2.y); ctx.stroke();
  }
  ctx.restore();
}

function finishDragDraw() {
  const { tool, x1, y1, x2, y2 } = dragDraw;
  const dx = x2 - x1;
  const dy = y2 - y1;
  const dist = Math.hypot(dx, dy);

  if (tool === 'circle') {
    const b = createBody({ shape: 'circle', x: x1, y: y1, radius: Math.max(0.2, dist) });
    selectObject('body', b.id);
  } else if (tool === 'rect' || tool === 'square') {
    const w = Math.max(0.3, Math.abs(dx));
    const h = tool === 'square' ? w : Math.max(0.3, Math.abs(dy));
    const b = createBody({ shape: 'rect', x: (x1 + x2) / 2, y: (y1 + y2) / 2, width: w, height: h });
    selectObject('body', b.id);
  } else if (tool === 'force') {
    const s1 = worldToScreen(x1, y1);
    const hit = hitTest(s1.x, s1.y, { x: x1, y: y1 });
    if (hit && hit.type === 'body') {
      const b = state.bodies.find(item => item.id === hit.id);
      const fx = dist > 0.1 ? dx * 5 : 10;
      const fy = dist > 0.1 ? dy * 5 : 0;
      const f = createForce({ bodyId: b.id, offsetX: x1 - b.x, offsetY: y1 - b.y, fx, fy });
      selectObject('force', f.id);
    } else {
      alert('Click on a body first to attach a Force vector!');
    }
  } else if (['spring', 'rod', 'rope'].includes(tool)) {
    const s1 = worldToScreen(x1, y1);
    const s2 = worldToScreen(x2, y2);
    const h1 = hitTest(s1.x, s1.y, { x: x1, y: y1 });
    const h2 = hitTest(s2.x, s2.y, { x: x2, y: y2 });
    if (h1 && h1.type === 'body') {
      const b1 = state.bodies.find(b => b.id === h1.id);
      const b2 = (h2 && h2.type === 'body' && h2.id !== b1.id) ? state.bodies.find(b => b.id === h2.id) : null;
      state.constraints.push({
        type: tool,
        b1: b1.id,
        off1x: x1 - b1.x,
        off1y: y1 - b1.y,
        b2: b2 ? b2.id : null,
        off2x: b2 ? x2 - b2.x : 0,
        off2y: b2 ? y2 - b2.y : 0,
        wx: x2,
        wy: y2,
        restLength: Math.max(0.2, dist),
        stiffness: 25
      });
    }
  }
  setTool('select');
}

function hitTest(sx, sy, wPos) {
  // Check forces first (near arrow tip or midpoint)
  for (let i = state.forces.length - 1; i >= 0; i--) {
    const f = state.forces[i];
    const b = state.bodies.find(item => item.id === f.bodyId);
    if (!b) continue;
    const p1 = worldToScreen(b.x + f.offsetX, b.y + f.offsetY);
    const p2 = { x: p1.x + f.fx * 6, y: p1.y - f.fy * 6 };
    if (distToSegment(sx, sy, p1.x, p1.y, p2.x, p2.y) < 10) {
      return { type: 'force', id: f.id };
    }
  }
  // Check bodies (topmost first)
  for (let i = state.bodies.length - 1; i >= 0; i--) {
    const b = state.bodies[i];
    if (!b.visible) continue;
    if (b.shape === 'circle') {
      if (Math.hypot(wPos.x - b.x, wPos.y - b.y) <= b.radius) return { type: 'body', id: b.id };
    } else if (b.shape === 'point') {
      if (Math.hypot(wPos.x - b.x, wPos.y - b.y) <= 0.25) return { type: 'body', id: b.id };
    } else {
      if (Math.abs(wPos.x - b.x) <= b.width / 2 && Math.abs(wPos.y - b.y) <= b.height / 2) {
        return { type: 'body', id: b.id };
      }
    }
  }
  return null;
}

function distToSegment(px, py, x1, y1, x2, y2) {
  const l2 = (x2 - x1) ** 2 + (y2 - y1) ** 2;
  if (l2 === 0) return Math.hypot(px - x1, py - y1);
  let t = ((px - x1) * (x2 - x1) + (py - y1) * (y2 - y1)) / l2;
  t = Math.max(0, Math.min(1, t));
  return Math.hypot(px - (x1 + t * (x2 - x1)), py - (y1 + t * (y2 - y1)));
}

function selectObject(type, id) {
  state.selected = { type, id };
  renderPropertiesWindow();
  renderAppearanceWindow();
  renderGeometryWindow();
  render();
}

