// --- DEFINE -> NEW CONTROL (SLIDERS & TEXT BOXES) ---
function createControlForSelected(prop) {
  let targetType = 'body';
  let targetId = 1;
  if (state.selected) {
    targetType = state.selected.type;
    targetId = state.selected.id;
  } else if (prop === 'magnitude' || prop === 'direction' || prop === 'fx' || prop === 'fy') {
    if (state.forces.length > 0) { targetType = 'force'; targetId = state.forces[0].id; }
  }

  const id = nextId.control++;
  const ctrl = {
    id,
    name: `Input[${id}]`,
    label: prop === 'magnitude' ? 'Magnitude' : (prop === 'direction' ? 'Direction' : prop.toUpperCase()),
    targetType,
    targetId,
    prop,
    style: 'slider', // 'slider' or 'textbox' (Step 5: make them text boxes instead of slide bar)
    min: 0,
    max: prop === 'direction' ? 360 : 20,
    value: prop === 'magnitude' ? 10 : 0,
    left: 20 + (id - 1) * 185,
    top: 25
  };
  state.controls.push(ctrl);

  // Auto-link formula on force if polar
  if (targetType === 'force') {
    const f = state.forces.find(item => item.id === targetId);
    if (f) {
      if (prop === 'magnitude') f.magFormula = `Input[${id}]`;
      if (prop === 'direction') f.dirFormula = `Input[${id}]*pi/180`;
      updateForceComponents(f);
    }
  }

  spawnControlWidget(ctrl);
  renderPropertiesWindow();
  render();
}

function spawnControlWidget(ctrl) {
  const div = document.createElement('div');
  div.className = 'canvas-widget';
  div.id = `ctrl-widget-${ctrl.id}`;
  div.style.left = ctrl.left + 'px';
  div.style.top = ctrl.top + 'px';
  div.style.width = '175px';

  div.innerHTML = `
    <div class="cw-title">
      <span>${ctrl.label} (${ctrl.name})</span>
      <span style="cursor:pointer;" onclick="openSingleControlSettings(${ctrl.id})" title="Control Properties">⚙</span>
    </div>
    <div style="padding:6px;" id="ctrl-body-${ctrl.id}"></div>
  `;
  wrapper.appendChild(div);
  makeDraggable(div);
  updateControlWidgetBody(ctrl);
}

function updateControlWidgetBody(ctrl) {
  const body = document.getElementById(`ctrl-body-${ctrl.id}`);
  if (!body) return;
  if (ctrl.style === 'textbox') {
    body.innerHTML = `
      <div style="display:flex; align-items:center; justify-content:space-between; gap:4px;">
        <span style="font-size:10px;">[${ctrl.min}..${ctrl.max}]</span>
        <input type="number" class="prop-input" style="width:90px;" min="${ctrl.min}" max="${ctrl.max}" step="any"
          value="${ctrl.value}" onchange="onControlValueChange(${ctrl.id}, this.value)">
      </div>
    `;
  } else {
    body.innerHTML = `
      <div style="display:flex; justify-content:space-between; font-size:10px;">
        <span>${ctrl.min}</span>
        <b>${ctrl.value}</b>
        <span>${ctrl.max}</span>
      </div>
      <input type="range" style="width:100%;" min="${ctrl.min}" max="${ctrl.max}" step="1"
        value="${ctrl.value}" oninput="onControlValueChange(${ctrl.id}, this.value)">
    `;
  }
}

function onControlValueChange(id, rawVal) {
  const ctrl = state.controls.find(c => c.id === id);
  if (!ctrl) return;
  let v = parseFloat(rawVal);
  if (isNaN(v)) v = 0;
  v = Math.max(ctrl.min, Math.min(ctrl.max, v));
  ctrl.value = v;
  updateControlWidgetBody(ctrl);

  // Update linked target
  if (ctrl.targetType === 'force') {
    const f = state.forces.find(item => item.id === ctrl.targetId);
    if (f) updateForceComponents(f);
  } else if (ctrl.targetType === 'body') {
    const b = state.bodies.find(item => item.id === ctrl.targetId);
    if (b) {
      if (ctrl.prop === 'mass') b.mass = Math.max(0.01, v);
      if (ctrl.prop === 'vx') b.vx = v;
      if (ctrl.prop === 'vy') b.vy = v;
    }
  }
  renderPropertiesWindow();
  render();
}

function openSingleControlSettings(id) {
  const ctrl = state.controls.find(c => c.id === id);
  if (!ctrl) return;
  showModal(`Control Properties - ${ctrl.name}`, `
    <div class="prop-row"><label>Control Name:</label><input class="prop-input" id="cp-lbl" value="${ctrl.label}"></div>
    <div class="prop-row"><label>Control Type:</label>
      <select class="prop-input" id="cp-style">
        <option value="slider" ${ctrl.style === 'slider' ? 'selected' : ''}>Slide Bar</option>
        <option value="textbox" ${ctrl.style === 'textbox' ? 'selected' : ''}>Text Box</option>
      </select>
    </div>
    <div class="prop-row"><label>Minimum Value:</label><input class="prop-input" type="number" id="cp-min" value="${ctrl.min}"></div>
    <div class="prop-row"><label>Maximum Value:</label><input class="prop-input" type="number" id="cp-max" value="${ctrl.max}"></div>
    <div style="text-align:right; margin-top:10px; display:flex; justify-content:flex-end; gap:6px;">
      <button class="win-action-btn" onclick="saveControlSettings(${ctrl.id})">OK</button>
      <button class="win-action-btn" onclick="closeModal()">Cancel</button>
    </div>
  `);
}

function saveControlSettings(id) {
  const ctrl = state.controls.find(c => c.id === id);
  if (ctrl) {
    ctrl.label = document.getElementById('cp-lbl').value;
    ctrl.style = document.getElementById('cp-style').value;
    ctrl.min = parseFloat(document.getElementById('cp-min').value) || 0;
    ctrl.max = parseFloat(document.getElementById('cp-max').value) || 100;
    document.querySelector(`#ctrl-widget-${ctrl.id} .cw-title span`).textContent = `${ctrl.label} (${ctrl.name})`;
    updateControlWidgetBody(ctrl);
  }
  closeModal();
}

// --- MEASURE -> METERS & GRAPHS ---
function createMeasure(type, display = 'Graph', customOpts = {}) {
  const bId = (state.selected && state.selected.type === 'body') ? state.selected.id : (state.bodies[0]?.id || 1);
  const id = nextId.meter++;

  let y1Label = type;
  let y1Formula = `Body[${bId}].P.X`;
  if (type === 'Time') { y1Formula = 't'; }
  else if (type === 'Position') { y1Formula = `Body[${bId}].P.X`; }
  else if (type === 'Velocity') { y1Formula = `Body[${bId}].V.X`; }
  else if (type === 'Acceleration') { y1Formula = `Body[${bId}].A.X`; }
  else if (type === 'Force') { y1Formula = `ConstraintForce[1]`; }
  else if (type === 'KineticEnergy') { y1Label = 'Translational KE'; y1Formula = `Body[${bId}].KE`; }
  else if (type === 'Momentum') { y1Formula = `Body[${bId}].M * Body[${bId}].V.X`; }

  const meter = {
    id,
    display,
    y1Label: customOpts.y1Label || y1Label,
    y1Formula: customOpts.y1Formula || y1Formula,
    y2Label: customOpts.y2Label || '',
    y2Formula: customOpts.y2Formula || '',
    val1: 0,
    val2: 0,
    data: [],
    left: 20 + (id - 1) * 230,
    top: 110
  };
  state.meters.push(meter);
  spawnMeterWidget(meter);
  selectObject('meter', id);
  return meter;
}

function spawnMeterWidget(m) {
  const div = document.createElement('div');
  div.className = 'canvas-widget';
  div.id = `meter-widget-${m.id}`;
  div.style.left = m.left + 'px';
  div.style.top = m.top + 'px';
  div.style.width = '230px';

  div.innerHTML = `
    <div class="cw-title" onclick="selectObject('meter', ${m.id})">
      <span id="meter-title-${m.id}">${m.y1Label}${m.y2Label ? ' & ' + m.y2Label : ''}</span>
      <div style="display:flex; gap:4px;">
        <span style="cursor:pointer;" onclick="selectObject('meter', ${m.id}); openFloatingWin('win-properties')" title="Properties">⚙</span>
        <span style="cursor:pointer;" onclick="removeMeter(${m.id})" title="Close">×</span>
      </div>
    </div>
    <div id="meter-body-${m.id}" style="padding:6px; background:white;"></div>
  `;
  wrapper.appendChild(div);
  makeDraggable(div);
  updateMeterDOM(m);
}

function updateMeterDOM(m) {
  const title = document.getElementById(`meter-title-${m.id}`);
  const body = document.getElementById(`meter-body-${m.id}`);
  if (!body) return;
  title.textContent = `${m.y1Label}${m.y2Label ? ' & ' + m.y2Label : ''}`;

  if (m.display === 'Meter') {
    body.innerHTML = `
      <div style="font-family:Courier New; font-size:12px;">
        <div><b>${m.y1Label}:</b> <span id="m-v1-${m.id}">${formatNum(m.val1)}</span></div>
        ${m.y2Formula ? `<div style="color:#0000aa;"><b>${m.y2Label || 'y2'}:</b> <span id="m-v2-${m.id}">${formatNum(m.val2)}</span></div>` : ''}
      </div>
    `;
  } else {
    body.innerHTML = `
      <div style="font-size:10px; display:flex; justify-content:space-between; margin-bottom:2px;">
        <span style="color:#cc0000;">${m.y1Label}: <b id="m-v1-${m.id}">${formatNum(m.val1)}</b></span>
        ${m.y2Formula ? `<span style="color:#0000cc;">${m.y2Label || 'y2'}: <b id="m-v2-${m.id}">${formatNum(m.val2)}</b></span>` : ''}
      </div>
      <canvas id="m-canvas-${m.id}" width="214" height="100" style="border:1px solid #ccc; display:block;"></canvas>
    `;
    drawMeterGraph(m);
  }
}

function recordMeters() {
  state.meters.forEach(m => {
    m.val1 = evaluateFormula(m.y1Formula);
    m.val2 = m.y2Formula ? evaluateFormula(m.y2Formula) : 0;
    m.data.push({ t: state.time, v1: m.val1, v2: m.val2 });
    if (m.data.length > 400) m.data.shift();

    const v1El = document.getElementById(`m-v1-${m.id}`);
    const v2El = document.getElementById(`m-v2-${m.id}`);
    if (v1El) v1El.textContent = formatNum(m.val1);
    if (v2El) v2El.textContent = formatNum(m.val2);
    if (m.display === 'Graph') drawMeterGraph(m);
  });
}

function drawMeterGraph(m) {
  const c = document.getElementById(`m-canvas-${m.id}`);
  if (!c) return;
  const gctx = c.getContext('2d');
  const w = c.width, h = c.height;
  gctx.clearRect(0, 0, w, h);

  // Grid
  gctx.strokeStyle = '#eee';
  gctx.beginPath();
  gctx.moveTo(0, h / 2); gctx.lineTo(w, h / 2);
  gctx.stroke();

  if (m.data.length < 2) return;
  const allVals = m.data.flatMap(d => m.y2Formula ? [d.v1, d.v2] : [d.v1]);
  let minV = Math.min(0, ...allVals);
  let maxV = Math.max(1, ...allVals);
  if (maxV === minV) maxV = minV + 1;

  // Plot y1 (Red)
  gctx.strokeStyle = '#cc0000';
  gctx.lineWidth = 1.5;
  gctx.beginPath();
  m.data.forEach((d, i) => {
    const px = (i / (m.data.length - 1)) * w;
    const py = h - ((d.v1 - minV) / (maxV - minV)) * (h - 10) - 5;
    if (i === 0) gctx.moveTo(px, py); else gctx.lineTo(px, py);
  });
  gctx.stroke();

  // Plot y2 (Blue)
  if (m.y2Formula) {
    gctx.strokeStyle = '#0000cc';
    gctx.beginPath();
    m.data.forEach((d, i) => {
      const px = (i / (m.data.length - 1)) * w;
      const py = h - ((d.v2 - minV) / (maxV - minV)) * (h - 10) - 5;
      if (i === 0) gctx.moveTo(px, py); else gctx.lineTo(px, py);
    });
    gctx.stroke();
  }
}

