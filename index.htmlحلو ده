      <button class="win-action-btn" onclick="closeModal()">Cancel</button>
    </div>
  `);
}

function saveControlSettings(id) {
  const ctrl = state.controls.find(c => c.id === id);
  if (ctrl) {
    ctrl.label = document.getElementById('cp-lbl').value || ctrl.label;
    ctrl.style = document.getElementById('cp-style').value;
    ctrl.min = parseFloat(document.getElementById('cp-min').value) || 0;
    ctrl.max = parseFloat(document.getElementById('cp-max').value) || 100;
    document.querySelector(`#ctrl-widget-${ctrl.id} .cw-title span`).textContent = `${ctrl.label} (${ctrl.name})`;
    updateControlWidgetBody(ctrl);
  }
  closeModal();
}

// --- MEASURE -> METERS & GRAPHS ---
function createMeasure(type, display = 'Graph', customOpts = {}) {
  const bId = (state.selected && state.selected.type === 'body') ? state.selected.id : (state.bodies[0]?.id || 1);
  const id = nextId.meter++;

  let y1Label = type;
  let y1Formula = `Body[${bId}].P.X`;
  if (type === 'Time') y1Formula = 't';
  else if (type === 'Position') y1Formula = `Body[${bId}].P.X`;
  else if (type === 'Displacement') y1Formula = `Body[${bId}].P.X`;
  else if (type === 'Velocity') y1Formula = `Body[${bId}].V.X`;
  else if (type === 'Acceleration') y1Formula = `Body[${bId}].A.X`;
  else if (type === 'Force') y1Formula = `ConstraintForce[1]`;
  else if (type === 'KineticEnergy') { y1Label = 'Translational KE'; y1Formula = `Body[${bId}].KE`; }
  else if (type === 'Momentum') y1Formula = `Body[${bId}].M * Body[${bId}].V.X`;

  const meter = {
    id,
    display,
    y1Label: customOpts.y1Label || y1Label,
    y1Formula: customOpts.y1Formula || y1Formula,
    y2Label: customOpts.y2Label || '',
    y2Formula: customOpts.y2Formula || '',
    val1: 0,
    val2: 0,
    data: [],
    left: 24 + ((id - 1) % 2) * 238,
    top: 115 + Math.floor((id - 1) / 2) * 155
  };
  state.meters.push(meter);
  spawnMeterWidget(meter);
  selectObject('meter', id);
  return meter;
}

function spawnMeterWidget(m) {
  const div = document.createElement('div');
  div.className = 'canvas-widget';
  div.id = `meter-widget-${m.id}`;
  div.style.left = m.left + 'px';
  div.style.top = m.top + 'px';
  div.style.width = '230px';

  div.innerHTML = `
    <div class="cw-title" onclick="selectObject('meter', ${m.id})">
      <span id="meter-title-${m.id}" style="overflow:hidden; text-overflow:ellipsis;">${m.y1Label}${m.y2Label ? ' & ' + m.y2Label : ''}</span>
      <div style="display:flex; gap:4px; flex-shrink:0;">
        <span style="cursor:pointer;" onclick="selectObject('meter', ${m.id}); openFloatingWin('win-properties')" title="Properties">⚙</span>
        <span style="cursor:pointer;" onclick="removeMeter(${m.id})" title="Close">×</span>
      </div>
    </div>
    <div id="meter-body-${m.id}" style="padding:6px; background:white;"></div>
  `;
  wrapper.appendChild(div);
  makeDraggable(div);
  updateMeterDOM(m);
  clampWidgetsInsideWorkspace();
}

function updateMeterDOM(m) {
  const title = document.getElementById(`meter-title-${m.id}`);
  const body = document.getElementById(`meter-body-${m.id}`);
  if (!body) return;
  if (title) title.textContent = `${m.y1Label}${m.y2Label ? ' & ' + m.y2Label : ''}`;

  if (m.display === 'Meter') {
    body.innerHTML = `
      <div style="font-family:'Courier New',monospace; font-size:12px;">
        <div><b>${m.y1Label}:</b> <span id="m-v1-${m.id}">${formatNum(m.val1)}</span></div>
        ${m.y2Formula ? `<div style="color:#0000aa;"><b>${m.y2Label || 'y2'}:</b> <span id="m-v2-${m.id}">${formatNum(m.val2)}</span></div>` : ''}
      </div>
    `;
  } else {
    body.innerHTML = `
      <div style="font-size:10px; display:flex; justify-content:space-between; gap:6px; margin-bottom:2px;">
        <span style="color:#cc0000;">${m.y1Label}: <b id="m-v1-${m.id}">${formatNum(m.val1)}</b></span>
        ${m.y2Formula ? `<span style="color:#0000cc;">${m.y2Label || 'y2'}: <b id="m-v2-${m.id}">${formatNum(m.val2)}</b></span>` : ''}
      </div>
      <canvas id="m-canvas-${m.id}" width="214" height="96" style="border:1px solid #ccc; display:block; max-width:100%;"></canvas>
    `;
    drawMeterGraph(m);
  }
}

function recordMeters() {
  state.meters.forEach(m => {
    m.val1 = evaluateFormula(m.y1Formula);
    m.val2 = m.y2Formula ? evaluateFormula(m.y2Formula) : 0;
    m.data.push({ t: state.time, v1: m.val1, v2: m.val2 });
    if (m.data.length > 350) m.data.shift();

    const v1El = document.getElementById(`m-v1-${m.id}`);
    const v2El = document.getElementById(`m-v2-${m.id}`);
    if (v1El) v1El.textContent = formatNum(m.val1);
    if (v2El) v2El.textContent = formatNum(m.val2);
    if (m.display === 'Graph') drawMeterGraph(m);
  });
}

function drawMeterGraph(m) {
  const c = document.getElementById(`m-canvas-${m.id}`);
  if (!c) return;
  const gctx = c.getContext('2d');
  const w = c.width, h = c.height;
  gctx.clearRect(0, 0, w, h);

  gctx.strokeStyle = '#eee';
  gctx.beginPath();
  gctx.moveTo(0, h / 2); gctx.lineTo(w, h / 2);
  gctx.stroke();

  if (m.data.length < 2) return;
  const allVals = m.data.flatMap(d => m.y2Formula ? [d.v1, d.v2] : [d.v1]);
  let minV = Math.min(0, ...allVals);
  let maxV = Math.max(1, ...allVals);
  if (maxV === minV) maxV = minV + 1;

  gctx.strokeStyle = '#cc0000';
  gctx.lineWidth = 1.5;
  gctx.beginPath();
  m.data.forEach((d, i) => {
    const px = (i / (m.data.length - 1)) * w;
    const py = h - ((d.v1 - minV) / (maxV - minV)) * (h - 10) - 5;
    if (i === 0) gctx.moveTo(px, py); else gctx.lineTo(px, py);
  });
  gctx.stroke();

  if (m.y2Formula) {
    gctx.strokeStyle = '#0000cc';
    gctx.beginPath();
    m.data.forEach((d, i) => {
      const px = (i / (m.data.length - 1)) * w;
      const py = h - ((d.v2 - minV) / (maxV - minV)) * (h - 10) - 5;
      if (i === 0) gctx.moveTo(px, py); else gctx.lineTo(px, py);
    });
    gctx.stroke();
  }
}

function removeMeter(id) {
  state.meters = state.meters.filter(m => m.id !== id);
  const el = document.getElementById(`meter-widget-${id}`);
  if (el) el.remove();
}

