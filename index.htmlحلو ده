  performNewReset();
}

function performNewReset() {
  stopSim();
  state.bodies = [];
  state.forces = [];
  state.constraints = [];
  state.controls = [];
  state.meters = [];
  state.texts = [];
  state.pauseConditions = [];
  state.selected = null;
  state.time = 0;
  state.frame = 0;
  initialSnapshot = null;
  nextId = { body: 1, force: 1, constraint: 1, control: 1, meter: 1, text: 1 };
  document.querySelectorAll('.canvas-widget').forEach(el => el.remove());
  document.getElementById('window-title').textContent = 'Interactive Physics - [Untitled1.ip]';
  renderPropertiesWindow();
  renderAppearanceWindow();
  renderGeometryWindow();
  updateUIReadouts();
  render();
  setStatus('New experiment created.');
}

function resetSessionPrompt() {
  showModal('Reset Session', `
    <div style="margin-bottom:10px;">Reset the entire simulation workspace to default?</div>
    <div style="text-align:right; display:flex; justify-content:flex-end; gap:6px;">
      <button class="win-action-btn" onclick="closeModal(); initDefaultScene();">Reset</button>
      <button class="win-action-btn" onclick="closeModal();">Cancel</button>
