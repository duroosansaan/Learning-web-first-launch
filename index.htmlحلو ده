function applyConstraintProps(id) {
  const c = state.constraints.find(item => item.id === id);
  if (!c) return;
  if (c.type === 'spring') {
    c.stiffness = parseFloat(document.getElementById('c-k').value) || 30;
    c.restLength = Math.max(0.1, parseFloat(document.getElementById('c-len').value) || 1);
  } else if (c.type === 'motor') {
    c.speed = parseFloat(document.getElementById('c-spd').value) || 0;
  }
  render();
}

function applyBodyProps(id) {
  const b = state.bodies.find(item => item.id === id);
  if (!b) return;
  saveUndoSnapshot();
  const mVal = document.getElementById('p-mass').value.trim();
  if (isNaN(Number(mVal))) { b.massFormula = mVal; b.mass = Math.max(0.01, evaluateFormula(mVal)); }
  else { b.massFormula = null; b.mass = Math.max(0.01, parseFloat(mVal) || 1); }

  b.x = parseFloat(document.getElementById('p-x').value) || 0;
  b.y = parseFloat(document.getElementById('p-y').value) || 0;
  b.angle = ((parseFloat(document.getElementById('p-ang').value) || 0) * Math.PI) / 180;

  const vxVal = document.getElementById('p-vx').value.trim();
  if (isNaN(Number(vxVal))) { b.vxFormula = vxVal; b.vx = evaluateFormula(vxVal); }
  else { b.vxFormula = null; b.vx = parseFloat(vxVal) || 0; }

  const vyVal = document.getElementById('p-vy').value.trim();
  if (isNaN(Number(vyVal))) { b.vyFormula = vyVal; b.vy = evaluateFormula(vyVal); }
  else { b.vyFormula = null; b.vy = parseFloat(vyVal) || 0; }

  b.staticFriction = parseFloat(document.getElementById('p-sf').value) || 0;
  b.kineticFriction = parseFloat(document.getElementById('p-kf').value) || 0;
  b.elasticity = parseFloat(document.getElementById('p-el').value) || 0;
  b.anchored = document.getElementById('p-anc').checked;
  render();
}

function toggleForcePolar(id, mode) {
  const f = state.forces.find(item => item.id === id);
  if (!f) return;
  f.isPolar = (mode === 'polar');
  updateForceComponents(f);
  renderPropertiesWindow();
  render();
}

function applyForceProps(id) {
  const f = state.forces.find(item => item.id === id);
  if (!f) return;
  if (!f.isPolar) {
    const fxVal = document.getElementById('f-fx').value.trim();
    const fyVal = document.getElementById('f-fy').value.trim();
    if (isNaN(Number(fxVal))) f.fxFormula = fxVal; else { f.fxFormula = null; f.fx = parseFloat(fxVal) || 0; }
    if (isNaN(Number(fyVal))) f.fyFormula = fyVal; else { f.fyFormula = null; f.fy = parseFloat(fyVal) || 0; }
  } else {
    const magVal = document.getElementById('f-mag').value.trim();
    const dirVal = document.getElementById('f-dir').value.trim();
    if (isNaN(Number(magVal))) f.magFormula = magVal; else { f.magFormula = null; f.mag = parseFloat(magVal) || 0; }
    if (isNaN(Number(dirVal))) f.dirFormula = dirVal; else { f.dirFormula = null; f.dir = parseFloat(dirVal) || 0; }
  }
  updateForceComponents(f);
  render();
}

function applyMeterProps(id) {
  const m = state.meters.find(item => item.id === id);
  if (!m) return;
  m.display = document.getElementById('m-mode').value;
  m.y1Label = document.getElementById('m-y1-lbl').value;
  m.y1Formula = document.getElementById('m-y1-eq').value;
  m.y2Label = document.getElementById('m-y2-lbl').value.trim();
  m.y2Formula = document.getElementById('m-y2-eq').value.trim();
  updateMeterDOM(m);
}

function renderAppearanceWindow() {
  const el = document.getElementById('app-win-body');
