// --- STEPS 12-14: W VS THETA TABLE & GRAPH ---
function openPlotWvsThetaModal() {
  const angles = [0, 45, 90, 135, 180, 225, 270, 315, 360];
  const rows = angles.map(deg => {
    const rad = deg * Math.PI / 180;
    const wVal = Math.round(10 * 3 * Math.cos(rad));
    return `<tr>
      <td style="border:1px solid #808080; padding:3px 8px;">${deg}°</td>
      <td style="border:1px solid #808080; padding:3px 8px; font-weight:bold;">${wVal} N.m</td>
    </tr>`;
  }).join('');

  showModal('Steps 12–14: Work (W) vs Angle (θ) Table & Graph', `
    <div class="w-theta-layout">
      <table style="border-collapse:collapse; background:white; text-align:center;">
        <tr style="background:#d4d0c8;">
          <th style="border:1px solid #808080; padding:4px 8px;">θ°</th>
          <th style="border:1px solid #808080; padding:4px 8px;">Work (W) N.m</th>
        </tr>
        ${rows}
      </table>
      <div style="max-width:250px;">
        <canvas id="w-theta-canvas" width="240" height="175" style="background:white; border:1px solid #808080; max-width:100%;"></canvas>
        <div style="font-size:10px; margin-top:5px; color:#222; line-height:1.4;">
          <b>Conclusion:</b> Work W = F · Δx · cos(θ) is maximum (+30 N.m) at 0° & 360°, zero at 90° & 270°, and negative (-30 N.m) at 180°.
        </div>
      </div>
    </div>
    <div style="text-align:right; margin-top:10px;">
      <button class="win-action-btn" onclick="closeModal()">Close</button>
    </div>
  `);

  requestAnimationFrame(() => {
    const c = document.getElementById('w-theta-canvas');
    if (!c) return;
    const g = c.getContext('2d');
    const w = c.width, h = c.height;
    g.strokeStyle = '#808080';
    g.beginPath(); g.moveTo(26, h / 2); g.lineTo(w - 10, h / 2); g.moveTo(26, 10); g.lineTo(26, h - 10); g.stroke();
    g.fillStyle = '#000'; g.font = '9px Tahoma';
    g.fillText('+30', 2, 20); g.fillText('0', 14, h / 2 + 3); g.fillText('-30', 2, h - 14);
    g.fillText('0°', 26, h / 2 + 12); g.fillText('180°', 114, h / 2 + 12); g.fillText('360°', 206, h / 2 + 12);

    g.strokeStyle = '#0000cc';
    g.lineWidth = 2;
    g.beginPath();
    for (let deg = 0; deg <= 360; deg += 5) {
      const px = 26 + (deg / 360) * (w - 40);
      const val = 30 * Math.cos(deg * Math.PI / 180);
      const py = (h / 2) - (val / 30) * (h / 2 - 18);
      if (deg === 0) g.moveTo(px, py); else g.lineTo(px, py);
    }
    g.stroke();
  });
}

