// --- DEFINE -> NEW CONTROL ---
function createControlForSelected(prop) {
  let targetType = 'body';
  let targetId = state.bodies[0]?.id || 1;
  if (state.selected) {
    targetType = state.selected.type;
    targetId = state.selected.id;
  } else if (['magnitude', 'direction', 'fx', 'fy'].includes(prop) && state.forces.length > 0) {
    targetType = 'force';
    targetId = state.forces[0].id;
  }

  const id = nextId.control++;
  const ctrl = {
    id,
    name: `Input[${id}]`,
    label: prop === 'magnitude' ? 'Magnitude' : (prop === 'direction' ? 'Direction' : prop.toUpperCase()),
    targetType,
    targetId,
    prop,
    style: 'slider',
    min: 0,
    max: prop === 'direction' ? 360 : 20,
    value: prop === 'magnitude' ? 10 : 0,
    left: 24 + ((id - 1) % 3) * 182,
    top: 24 + Math.floor((id - 1) / 3) * 76
  };
  state.controls.push(ctrl);

  if (targetType === 'force') {
    const f = state.forces.find(item => item.id === targetId);
    if (f) {
      f.isPolar = true;
      if (prop === 'magnitude') f.magFormula = `Input[${id}]`;
      if (prop === 'direction') f.dirFormula = `Input[${id}]*pi/180`;
      updateForceComponents(f);
    }
  }

  spawnControlWidget(ctrl);
  renderPropertiesWindow();
  render();
}

function spawnControlWidget(ctrl) {
  const div = document.createElement('div');
  div.className = 'canvas-widget';
  div.id = `ctrl-widget-${ctrl.id}`;
  div.style.left = ctrl.left + 'px';
  div.style.top = ctrl.top + 'px';
  div.style.width = '180px';

  div.innerHTML = `
    <div class="cw-title">
      <span style="overflow:hidden; text-overflow:ellipsis;">${ctrl.label} (${ctrl.name})</span>
      <div style="display:flex; gap:4px; flex-shrink:0;">
        <span style="cursor:pointer;" onclick="openSingleControlSettings(${ctrl.id})" title="Control Properties">⚙</span>
        <span style="cursor:pointer;" onclick="removeControl(${ctrl.id})" title="Delete Control">×</span>
      </div>
    </div>
    <div style="padding:6px;" id="ctrl-body-${ctrl.id}"></div>
  `;
  wrapper.appendChild(div);
  makeDraggable(div);
  updateControlWidgetBody(ctrl);
  clampWidgetsInsideWorkspace();
}

function removeControl(id) {
  saveUndoSnapshot();
  state.controls = state.controls.filter(c => c.id !== id);
  const el = document.getElementById(`ctrl-widget-${id}`);
  if (el) el.remove();
  render();
}

function openSingleControlSettings(id) {
  const ctrl = state.controls.find(c => c.id === id);
  if (!ctrl) return;
  showModal(`Control Properties - ${ctrl.name}`, `
    <div class="prop-row"><label>Control Name:</label><input class="prop-input" id="cp-lbl" value="${ctrl.label}"></div>
    <div class="prop-row"><label>Control Type:</label>
      <select class="prop-input" id="cp-style">
        <option value="slider" ${ctrl.style === 'slider' ? 'selected' : ''}>Slide Bar</option>
        <option value="textbox" ${ctrl.style === 'textbox' ? 'selected' : ''}>Text Box</option>
      </select>
    </div>
