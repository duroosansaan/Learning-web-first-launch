<script>
/**
 * ============================================================================
 * INTERACTIVE PHYSICS - ENHANCED RIGID BODY & MANIPULATION ENGINE
 * ============================================================================
 */

const state = {
  running: false,
  time: 0,
  frame: 0,
  accuracyFPS: 100,
  decimalDigits: 2,
  gravity: { enabled: true, x: 0, y: -9.8 },
  airResistance: { enabled: false, k: 0.05 },
  electrostatics: { enabled: false, k: 8.99e9 },
  forceField: { enabled: false, fx: 0, fy: 0 },
  collisionsEnabled: true,
  pauseConditions: [],
  view: {
    zoom: 60,
    panX: 0,
    panY: 0,
    grid: true,
    snap: false,
    axes: true,
    rulers: true,
    tracking: true,
    vectors: { vel: false, acc: false, force: true }
  },
  tool: 'select',
  bodies: [],
  forces: [],
  constraints: [],
  controls: [],
  meters: [],
  texts: [],
  selected: null, // { type: 'body'|'force'|'constraint'|'control'|'meter'|'text', id: number }
  hovered: null,
  clipboard: null,
  undoStack: [],
  redoStack: [],
  userScript: "// Example Script:\n// Body[0].vx = 2;\n// runSim();"
};

let nextId = { body: 1, force: 1, constraint: 1, control: 1, meter: 1, text: 1 };
let initialSnapshot = null;

const canvas = document.getElementById('sim-canvas');
const ctx = canvas.getContext('2d');
const wrapper = document.getElementById('workspace-wrapper');

function saveUndoSnapshot() {
  const snap = JSON.stringify({
    bodies: state.bodies,
    forces: state.forces,
    constraints: state.constraints,
    controls: state.controls,
    meters: state.meters,
    texts: state.texts,
    nextId: { ...nextId }
  });
  if (state.undoStack.length > 0 && state.undoStack[state.undoStack.length - 1] === snap) return;
  state.undoStack.push(snap);
  if (state.undoStack.length > 40) state.undoStack.shift();
  state.redoStack = [];
}

function restoreFullSnapshot(snapStr) {
  const snap = JSON.parse(snapStr);
  state.bodies = snap.bodies || [];
  state.forces = snap.forces || [];
  state.constraints = snap.constraints || [];
  state.controls = snap.controls || [];
  state.meters = snap.meters || [];
  state.texts = snap.texts || [];
  if (snap.nextId) nextId = { ...snap.nextId };
  state.selected = null;

  document.querySelectorAll('.canvas-widget').forEach(el => el.remove());
  state.controls.forEach(spawnControlWidget);
  state.meters.forEach(spawnMeterWidget);
  renderPropertiesWindow();
  renderAppearanceWindow();
  renderGeometryWindow();
  render();
}

function resizeCanvas() {
  const w = Math.max(100, wrapper.clientWidth);
  const h = Math.max(100, wrapper.clientHeight);
  canvas.width = w;
  canvas.height = h;
  clampWidgetsInsideWorkspace();
  render();
}

window.addEventListener('resize', resizeCanvas);
window.addEventListener('orientationchange', () => setTimeout(resizeCanvas, 120));

function clampWidgetsInsideWorkspace() {
  const maxW = wrapper.clientWidth;
  const maxH = wrapper.clientHeight;
  document.querySelectorAll('.canvas-widget, .floating-win').forEach(el => {
    if (el.style.display === 'none') return;
    const rect = el.getBoundingClientRect();
    const wRect = wrapper.getBoundingClientRect();
    let left = rect.left - wRect.left;
    let top = rect.top - wRect.top;
    if (left + rect.width > maxW - 6) left = Math.max(4, maxW - rect.width - 6);
    if (top + rect.height > maxH - 6) top = Math.max(4, maxH - rect.height - 6);
    if (left < 4) left = 4;
    if (top < 4) top = 4;
    el.style.left = left + 'px';
    el.style.top = top + 'px';
    el.style.right = 'auto';
  });
}

function worldToScreen(wx, wy) {
  const cx = canvas.width / 2 + state.view.panX;
  const cy = canvas.height / 2 + state.view.panY;
  return {
    x: cx + wx * state.view.zoom,
    y: cy - wy * state.view.zoom
  };
}

function screenToWorld(sx, sy) {
  const cx = canvas.width / 2 + state.view.panX;
  const cy = canvas.height / 2 + state.view.panY;
  return {
    x: (sx - cx) / state.view.zoom,
    y: (cy - sy) / state.view.zoom
  };
}

function applySnap(wPos) {
  if (!state.view.snap) return wPos;
  const step = 0.5;
  return {
    x: Math.round(wPos.x / step) * step,
    y: Math.round(wPos.y / step) * step
  };
}

function rotateVec(x, y, ang) {
  const c = Math.cos(ang), s = Math.sin(ang);
  return { x: x * c - y * s, y: x * s + y * c };
}

/**
 * Safe recursive-descent math expression evaluator
 */
function evaluateFormula(expr) {
  if (typeof expr === 'number') return Number.isFinite(expr) ? expr : 0;
  if (!expr || String(expr).trim() === '') return 0;

  let src = String(expr).trim();
  while (/\|[^|]+\|/.test(src)) {
    src = src.replace(/\|([^|]+)\|/g, 'abs($1)');
  }

  src = src.replace(/\bpi\b/gi, () => String(Math.PI));
  src = src.replace(/\bt\b/g, () => String(state.time));

  src = src.replace(/Input\[(\d+)\]/gi, (_, id) => {
    const ctrl = state.controls.find(c => c.id === parseInt(id, 10));
    const val = ctrl ? parseFloat(ctrl.value) : 0;
    return String(Number.isFinite(val) ? val : 0);
  });

  src = src.replace(/(?:ConstraintForce|Force)\[(\d+)\]/gi, (_, id) => {
    const f = state.forces.find(item => item.id === parseInt(id, 10));
    if (!f) return '0';
    return String(Math.hypot(f.fx || 0, f.fy || 0));
  });

  src = src.replace(/Body\[(\d+)\]\.([A-Za-z0-9_.]+)/gi, (_, id, propPath) => {
    const b = state.bodies.find(item => item.id === parseInt(id, 10));
    if (!b) return '0';
    const p = propPath.toUpperCase();
    if (p === 'P.X' || p === 'X') return String(b.x);
    if (p === 'P.Y' || p === 'Y') return String(b.y);
    if (p === 'V.X' || p === 'VX') return String(b.vx);
    if (p === 'V.Y' || p === 'VY') return String(b.vy);
    if (p === 'V') return String(Math.hypot(b.vx, b.vy));
    if (p === 'A.X' || p === 'AX') return String(b.ax);
    if (p === 'A.Y' || p === 'AY') return String(b.ay);
    if (p === 'A') return String(Math.hypot(b.ax, b.ay));
    if (p === 'M' || p === 'MASS') return String(b.mass);
    if (p === 'KE') return String(0.5 * b.mass * (b.vx * b.vx + b.vy * b.vy));
    return '0';
  });

  const tokens = [];
  let i = 0;
  while (i < src.length) {
    const ch = src[i];
    if (/\s/.test(ch)) { i++; continue; }
    if (/[0-9.]/.test(ch)) {
      let numStr = '';
      while (i < src.length && /[0-9.eE+-]/.test(src[i])) {
        if ((src[i] === '+' || src[i] === '-') && numStr.slice(-1).toLowerCase() !== 'e') break;
        numStr += src[i++];
      }
      const n = parseFloat(numStr);
      tokens.push({ type: 'num', value: Number.isFinite(n) ? n : 0 });
      continue;
    }
    if (/[a-zA-Z_]/.test(ch)) {
      let fnName = '';
      while (i < src.length && /[a-zA-Z0-9_]/.test(src[i])) fnName += src[i++];
      tokens.push({ type: 'fn', value: fnName.toLowerCase() });
      continue;
    }
    if ('+-*/^(),'.includes(ch)) {
      tokens.push({ type: 'op', value: ch });
      i++;
      continue;
    }
    i++;
  }

  let pos = 0;
  function peek() { return tokens[pos]; }
  function consume() { return tokens[pos++]; }

  function parseExpr() {
    let left = parseTerm();
    while (peek() && peek().type === 'op' && (peek().value === '+' || peek().value === '-')) {
      const op = consume().value;
      const right = parseTerm();
      left = op === '+' ? left + right : left - right;
    }
    return left;
  }

  function parseTerm() {
    let left = parsePower();
    while (peek() && peek().type === 'op' && (peek().value === '*' || peek().value === '/')) {
      const op = consume().value;
      const right = parsePower();
      if (op === '/') left = Math.abs(right) < 1e-12 ? 0 : left / right;
      else left = left * right;
    }
    return left;
  }

  function parsePower() {
    let base = parseUnary();
    if (peek() && peek().type === 'op' && peek().value === '^') {
      consume();
      const exp = parseUnary();
      base = Math.pow(base, exp);
    }
    return base;
  }

  function parseUnary() {
    if (peek() && peek().type === 'op' && peek().value === '+') { consume(); return parseUnary(); }
    if (peek() && peek().type === 'op' && peek().value === '-') { consume(); return -parseUnary(); }
    return parsePrimary();
  }

  function parsePrimary() {
    const tok = peek();
    if (!tok) return 0;
    if (tok.type === 'num') { consume(); return tok.value; }
    if (tok.type === 'fn') {
      const fn = consume().value;
      if (peek() && peek().type === 'op' && peek().value === '(') {
        consume();
        const arg = parseExpr();
        if (peek() && peek().type === 'op' && peek().value === ')') consume();
        if (fn === 'sin') return Math.sin(arg);
        if (fn === 'cos') return Math.cos(arg);
        if (fn === 'tan') return Math.tan(arg);
        if (fn === 'sqrt') return arg < 0 ? 0 : Math.sqrt(arg);
        if (fn === 'abs') return Math.abs(arg);
      }
      return 0;
    }
    if (tok.type === 'op' && tok.value === '(') {
      consume();
      const val = parseExpr();
      if (peek() && peek().type === 'op' && peek().value === ')') consume();
      return val;
    }
    consume();
    return 0;
  }

  try {
    const out = parseExpr();
    return Number.isFinite(out) ? out : 0;
  } catch (_) {
    return 0;
  }
}

function evaluateCondition(condStr) {
  if (!condStr || !condStr.trim()) return false;
  const parts = condStr.match(/^(.+?)(>=|<=|==|=|>|<)(.+)$/);
  if (!parts) return false;
  const lhs = evaluateFormula(parts[1]);
  const op = parts[2];
  const rhs = evaluateFormula(parts[3]);
  switch (op) {
    case '>=': return lhs >= rhs;
    case '<=': return lhs <= rhs;
    case '>': return lhs > rhs;
    case '<': return lhs < rhs;
    case '=':
    case '==': return Math.abs(lhs - rhs) < 1e-4;
    default: return false;
  }
}

// --- OBJECT FACTORIES ---
function computeMomentOfInertia(b) {
  if (b.anchored || b.shape === 'point' || b.mass <= 0) return Infinity;
  if (b.shape === 'circle') return 0.5 * b.mass * b.radius * b.radius;
  return (1 / 12) * b.mass * (b.width * b.width + b.height * b.height);
}

function createBody(opts) {
  const id = nextId.body++;
  const body = {
    id,
    name: opts.name || `Body[${id}]`,
    shape: opts.shape || 'rect',
    x: opts.x ?? 0,
    y: opts.y ?? 0,
    vx: opts.vx ?? 0,
    vy: opts.vy ?? 0,
    ax: 0,
    ay: 0,
    angle: opts.angle ?? 0,
    omega: opts.omega ?? 0,
    alpha: 0,
    mass: Math.max(0.01, opts.mass ?? 1.0),
    massFormula: opts.massFormula || null,
    vxFormula: opts.vxFormula || null,
    vyFormula: opts.vyFormula || null,
    width: opts.width ?? 1.0,
    height: opts.height ?? 1.0,
    radius: opts.radius ?? 0.5,
    points: opts.points || [],
    staticFriction: opts.staticFriction ?? 0.3,
    kineticFriction: opts.kineticFriction ?? 0.2,
    elasticity: opts.elasticity ?? 0.5,
    charge: opts.charge ?? 0,
    anchored: opts.anchored ?? false,
    color: opts.color || (opts.anchored ? '#c0c0c0' : '#99ccff'),
    borderColor: opts.borderColor || '#000000',
    visible: opts.visible ?? true,
    trail: []
  };
  state.bodies.push(body);
  return body;
}

function createForce(opts) {
  const id = nextId.force++;
  const force = {
    id,
    name: `ConstraintForce[${id}]`,
    bodyId: opts.bodyId,
    offsetX: opts.offsetX ?? 0,
    offsetY: opts.offsetY ?? 0,
    isPolar: opts.isPolar ?? false,
    fx: opts.fx ?? 10,
    fy: opts.fy ?? 0,
    mag: opts.mag ?? 10,
    dir: opts.dir ?? 0,
    fxFormula: opts.fxFormula || null,
    fyFormula: opts.fyFormula || null,
    magFormula: opts.magFormula || null,
    dirFormula: opts.dirFormula || null,
    color: '#cc0000'
  };
  updateForceComponents(force);
  state.forces.push(force);
  return force;
}

function updateForceComponents(f) {
  state.controls.forEach(c => {
    if (c.targetType === 'force' && c.targetId === f.id) {
      if (c.prop === 'magnitude' && !f.magFormula) f.mag = parseFloat(c.value) || 0;
      if (c.prop === 'direction' && !f.dirFormula) f.dir = parseFloat(c.value) || 0;
      if (c.prop === 'fx' && !f.fxFormula) f.fx = parseFloat(c.value) || 0;
      if (c.prop === 'fy' && !f.fyFormula) f.fy = parseFloat(c.value) || 0;
    }
  });

  if (f.isPolar) {
    const m = f.magFormula ? evaluateFormula(f.magFormula) : f.mag;
    const d = f.dirFormula ? evaluateFormula(f.dirFormula) : f.dir;
    f.mag = m;
    f.dir = d;
    f.fx = m * Math.cos(d);
    f.fy = m * Math.sin(d);
  } else {
    f.fx = f.fxFormula ? evaluateFormula(f.fxFormula) : f.fx;
    f.fy = f.fyFormula ? evaluateFormula(f.fyFormula) : f.fy;
    f.mag = Math.hypot(f.fx, f.fy);
    f.dir = Math.atan2(f.fy, f.fx);
  }
}

// --- REALISTIC 2D RIGID BODY & SAT COLLISION ENGINE ---
function stepPhysics(dt) {
  state.bodies.forEach(b => {
    if (b.massFormula) b.mass = Math.max(0.01, evaluateFormula(b.massFormula));
    if (state.time === 0) {
      if (b.vxFormula) b.vx = evaluateFormula(b.vxFormula);
      if (b.vyFormula) b.vy = evaluateFormula(b.vyFormula);
    }
  });
  state.forces.forEach(updateForceComponents);

  const netF = new Map();
  state.bodies.forEach(b => netF.set(b.id, { fx: 0, fy: 0, torque: 0 }));

  // 1. World Forces (Gravity, Force Field, Air Resistance)
  state.bodies.forEach(b => {
    if (b.anchored || b.shape === 'point') return;
    const f = netF.get(b.id);
    if (state.gravity.enabled) {
      f.fx += b.mass * state.gravity.x;
      f.fy += b.mass * state.gravity.y;
    }
    if (state.forceField.enabled) {
      f.fx += state.forceField.fx;
      f.fy += state.forceField.fy;
    }
    if (state.airResistance.enabled) {
      f.fx -= state.airResistance.k * b.vx;
      f.fy -= state.airResistance.k * b.vy;
    }
  });

  // 2. Applied Forces & Torque (r x F)
  state.forces.forEach(force => {
    const b = state.bodies.find(item => item.id === force.bodyId);
    if (b && !b.anchored) {
      const f = netF.get(b.id);
      const rWorld = rotateVec(force.offsetX, force.offsetY, b.angle);
      f.fx += force.fx;
      f.fy += force.fy;
      f.torque += rWorld.x * force.fy - rWorld.y * force.fx;
    }
  });

  // 3. Constraints (Springs, Rods, Ropes, Pins, Motors)
  state.constraints.forEach(c => {
    const b1 = state.bodies.find(b => b.id === c.b1);
    const b2 = c.b2 ? state.bodies.find(b => b.id === c.b2) : null;
    if (!b1) return;

    const r1 = rotateVec(c.off1x || 0, c.off1y || 0, b1.angle);
    const p1x = b1.x + r1.x;
    const p1y = b1.y + r1.y;

    const r2 = b2 ? rotateVec(c.off2x || 0, c.off2y || 0, b2.angle) : { x: 0, y: 0 };
    const p2x = b2 ? b2.x + r2.x : c.wx;
    const p2y = b2 ? b2.y + r2.y : c.wy;

    const dx = p2x - p1x;
    const dy = p2y - p1y;
    const dist = Math.hypot(dx, dy) || 1e-6;
    const nx = dx / dist;
    const ny = dy / dist;

    // Velocity at attachment points
    const v1x = b1.vx - b1.omega * r1.y;
    const v1y = b1.vy + b1.omega * r1.x;
    const v2x = b2 ? (b2.vx - b2.omega * r2.y) : 0;
    const v2y = b2 ? (b2.vy + b2.omega * r2.x) : 0;
    const rvx = v2x - v1x;
    const rvy = v2y - v1y;

    if (c.type === 'spring') {
      const stretch = dist - c.restLength;
      const k = c.stiffness || 30;
      const damp = c.damping || 0.8;
      const fMag = k * stretch + damp * (rvx * nx + rvy * ny);
      const fx = fMag * nx, fy = fMag * ny;
      if (!b1.anchored) {
        const f1 = netF.get(b1.id);
        f1.fx += fx; f1.fy += fy;
        f1.torque += r1.x * fy - r1.y * fx;
      }
      if (b2 && !b2.anchored) {
        const f2 = netF.get(b2.id);
        f2.fx -= fx; f2.fy -= fy;
        f2.torque -= r2.x * fy - r2.y * fx;
      }
    } else if (c.type === 'rod' || c.type === 'rope') {
      if (c.type === 'rope' && dist <= c.restLength) return;
      const stretch = dist - c.restLength;
      const k = 2500;
      const damp = 25;
      const fMag = k * stretch + damp * (rvx * nx + rvy * ny);
      const fx = fMag * nx, fy = fMag * ny;
      if (!b1.anchored) {
        const f1 = netF.get(b1.id);
        f1.fx += fx; f1.fy += fy;
        f1.torque += r1.x * fy - r1.y * fx;
      }
      if (b2 && !b2.anchored) {
        const f2 = netF.get(b2.id);
        f2.fx -= fx; f2.fy -= fy;
        f2.torque -= r2.x * fy - r2.y * fx;
      }
    } else if (c.type === 'pin') {
      const k = 3000;
      const damp = 35;
      const fx = k * dx + damp * rvx;
      const fy = k * dy + damp * rvy;
      if (!b1.anchored) {
        const f1 = netF.get(b1.id);
        f1.fx += fx; f1.fy += fy;
        f1.torque += r1.x * fy - r1.y * fx;
      }
      if (b2 && !b2.anchored) {
        const f2 = netF.get(b2.id);
        f2.fx -= fx; f2.fy -= fy;
        f2.torque -= r2.x * fy - r2.y * fx;
      }
    } else if (c.type === 'motor') {
      if (!b1.anchored) b1.omega = c.speed || 2.0;
    }
  });

  // 4. Semi-Implicit Euler Integration (Linear + Angular)
  state.bodies.forEach(b => {
    if (b.anchored || b.shape === 'point') {
      b.vx = 0; b.vy = 0; b.ax = 0; b.ay = 0; b.omega = 0; b.alpha = 0;
      return;
    }
    const f = netF.get(b.id);
    const I = computeMomentOfInertia(b);
    b.ax = f.fx / b.mass;
    b.ay = f.fy / b.mass;
    b.alpha = Number.isFinite(I) && I > 0 ? f.torque / I : 0;

    b.vx += b.ax * dt;
    b.vy += b.ay * dt;
    b.omega = (b.omega + b.alpha * dt) * 0.9995; // subtle numerical rotational stability

    b.x += b.vx * dt;
    b.y += b.vy * dt;
    b.angle += b.omega * dt;

    if (state.view.tracking && state.frame % 4 === 0) {
      b.trail.push({ x: b.x, y: b.y });
      if (b.trail.length > 140) b.trail.shift();
    }
  });

  // 5. SAT & Circle-Polygon Rigid Body Collisions
  if (state.collisionsEnabled) {
    resolveCollisions(dt);
  }

  state.time += dt;
  state.frame++;
  recordMeters();

  for (let i = 0; i < state.pauseConditions.length; i++) {
    const cond = state.pauseConditions[i];
    if (evaluateCondition(cond)) {
      stopSim();
      setStatus(`Paused: condition "${cond}" met at t = ${state.time.toFixed(2)} s.`);
      break;
    }
  }
}

// Get world vertices for Polygon / Rectangle
function getWorldVertices(b) {
  if (b.shape === 'polygon' && b.points.length >= 3) {
    return b.points.map(pt => {
      const r = rotateVec(pt.x, pt.y, b.angle);
      return { x: b.x + r.x, y: b.y + r.y };
    });
  }
  const hw = b.width / 2, hh = b.height / 2;
  const local = [
    { x: -hw, y: -hh },
    { x: hw, y: -hh },
    { x: hw, y: hh },
    { x: -hw, y: hh }
  ];
  return local.map(pt => {
    const r = rotateVec(pt.x, pt.y, b.angle);
    return { x: b.x + r.x, y: b.y + r.y };
  });
}

function projectVerts(verts, ax, ay) {
  let min = Infinity, max = -Infinity;
  for (let v of verts) {
    const p = v.x * ax + v.y * ay;
    if (p < min) min = p;
    if (p > max) max = p;
  }
  return { min, max };
}

function collideBodies(A, B) {
  // Circle vs Circle
  if (A.shape === 'circle' && B.shape === 'circle') {
    const dx = B.x - A.x, dy = B.y - A.y;
    const dist = Math.hypot(dx, dy);
    const rSum = A.radius + B.radius;
    if (dist >= rSum) return null;
    const nx = dist > 1e-6 ? dx / dist : 0;
    const ny = dist > 1e-6 ? dy / dist : 1;
    return {
      nx, ny,
      depth: rSum - dist,
      contactX: A.x + nx * A.radius,
      contactY: A.y + ny * A.radius
    };
  }

  // Circle vs Polygon/Rect
  if (A.shape === 'circle' || B.shape === 'circle') {
    const circ = A.shape === 'circle' ? A : B;
    const poly = A.shape === 'circle' ? B : A;
    const verts = getWorldVertices(poly);
    let minOverlap = Infinity;
    let bestNx = 0, bestNy = 0;

    const axes = [];
    for (let i = 0; i < verts.length; i++) {
      const v1 = verts[i], v2 = verts[(i + 1) % verts.length];
      const ex = v2.x - v1.x, ey = v2.y - v1.y;
      const len = Math.hypot(ex, ey) || 1;
      axes.push({ x: -ey / len, y: ex / len });
    }
    // Closest vertex axis
    let closestV = verts[0], minD = Infinity;
    for (let v of verts) {
      const d = Math.hypot(circ.x - v.x, circ.y - v.y);
      if (d < minD) { minD = d; closestV = v; }
    }
    if (minD > 1e-6) {
      axes.push({ x: (circ.x - closestV.x) / minD, y: (circ.y - closestV.y) / minD });
    }

    for (let ax of axes) {
      const pPoly = projectVerts(verts, ax.x, ax.y);
      const cProj = circ.x * ax.x + circ.y * ax.y;
      const pCirc = { min: cProj - circ.radius, max: cProj + circ.radius };
      const overlap = Math.min(pPoly.max, pCirc.max) - Math.max(pPoly.min, pCirc.min);
      if (overlap <= 0) return null;
      if (overlap < minOverlap) {
        minOverlap = overlap;
        bestNx = ax.x;
        bestNy = ax.y;
      }
    }

    // Ensure normal points from A -> B
    const dirAB = (B.x - A.x) * bestNx + (B.y - A.y) * bestNy;
    if (dirAB < 0) { bestNx = -bestNx; bestNy = -bestNy; }

    const signToCirc = (circ === B) ? -1 : 1;
    return {
      nx: bestNx,
      ny: bestNy,
      depth: minOverlap,
      contactX: circ.x + bestNx * signToCirc * circ.radius,
      contactY: circ.y + bestNy * signToCirc * circ.radius
    };
  }

  // Polygon/Rect vs Polygon/Rect (SAT)
  const vA = getWorldVertices(A);
  const vB = getWorldVertices(B);
  let minOverlap = Infinity;
  let bestNx = 0, bestNy = 0;

  const edges = [];
  for (let i = 0; i < vA.length; i++) edges.push([vA[i], vA[(i + 1) % vA.length]]);
  for (let i = 0; i < vB.length; i++) edges.push([vB[i], vB[(i + 1) % vB.length]]);

  for (let [p1, p2] of edges) {
    const ex = p2.x - p1.x, ey = p2.y - p1.y;
    const len = Math.hypot(ex, ey) || 1;
    const ax = -ey / len, ay = ex / len;
    const projA = projectVerts(vA, ax, ay);
    const projB = projectVerts(vB, ax, ay);
    const overlap = Math.min(projA.max, projB.max) - Math.max(projA.min, projB.min);
    if (overlap <= 0) return null;
    if (overlap < minOverlap) {
      minOverlap = overlap;
      bestNx = ax;
      bestNy = ay;
    }
  }

  if ((B.x - A.x) * bestNx + (B.y - A.y) * bestNy < 0) {
    bestNx = -bestNx; bestNy = -bestNy;
  }

  // Approximate contact point as deepest vertex
  let contactX = (A.x + B.x) / 2, contactY = (A.y + B.y) / 2;
  let maxPen = -Infinity;
  for (let v of vA) {
    const pen = (v.x - B.x) * bestNx + (v.y - B.y) * bestNy;
    if (pen > maxPen) { maxPen = pen; contactX = v.x; contactY = v.y; }
  }

  return { nx: bestNx, ny: bestNy, depth: minOverlap, contactX, contactY };
}

function resolveCollisions(dt) {
  for (let iter = 0; iter < 2; iter++) {
    for (let i = 0; i < state.bodies.length; i++) {
      for (let j = i + 1; j < state.bodies.length; j++) {
        const A = state.bodies[i];
        const B = state.bodies[j];
        if (A.shape === 'point' || B.shape === 'point') continue;
        if (A.anchored && B.anchored) continue;

        const hit = collideBodies(A, B);
        if (!hit) continue;

        const invMassA = A.anchored ? 0 : 1 / A.mass;
        const invMassB = B.anchored ? 0 : 1 / B.mass;
        const invMassSum = invMassA + invMassB;
        if (invMassSum === 0) continue;

        // Positional Baumgarte stabilization
        const slop = 0.002;
        const percent = 0.8;
        const corr = Math.max(0, hit.depth - slop) / invMassSum * percent;
        if (!A.anchored) { A.x -= hit.nx * corr * invMassA; A.y -= hit.ny * corr * invMassA; }
        if (!B.anchored) { B.x += hit.nx * corr * invMassB; B.y += hit.ny * corr * invMassB; }

        const rAx = hit.contactX - A.x, rAy = hit.contactY - A.y;
        const rBx = hit.contactX - B.x, rBy = hit.contactY - B.y;

        const vAx = A.vx - A.omega * rAy, vAy = A.vy + A.omega * rAx;
        const vBx = B.vx - B.omega * rBy, vBy = B.vy + B.omega * rBx;

        const rvx = vBx - vAx, rvy = vBy - vAy;
        const velAlongNormal = rvx * hit.nx + rvy * hit.ny;
        if (velAlongNormal > 0) continue;

        const e = Math.abs(velAlongNormal) < 0.2 ? 0 : Math.min(A.elasticity, B.elasticity);
        const invIA = A.anchored ? 0 : 1 / computeMomentOfInertia(A);
        const invIB = B.anchored ? 0 : 1 / computeMomentOfInertia(B);

        const rnA = rAx * hit.ny - rAy * hit.nx;
        const rnB = rBx * hit.ny - rBy * hit.nx;
        const denom = invMassSum + rnA * rnA * invIA + rnB * rnB * invIB;

        const jImp = -(1 + e) * velAlongNormal / denom;
        const impX = jImp * hit.nx, impY = jImp * hit.ny;

        if (!A.anchored) {
          A.vx -= impX * invMassA;
          A.vy -= impY * invMassA;
          A.omega -= (rAx * impY - rAy * impX) * invIA;
        }
        if (!B.anchored) {
          B.vx += impX * invMassB;
          B.vy += impY * invMassB;
          B.omega += (rBx * impY - rBy * impX) * invIB;
        }

        // Coulomb Friction Impulse
        const tx = -hit.ny, ty = hit.nx;
        const vt = rvx * tx + rvy * ty;
        const rtA = rAx * ty - rAy * tx;
        const rtB = rBx * ty - rBy * tx;
        const denomT = invMassSum + rtA * rtA * invIA + rtB * rtB * invIB;
        let jt = -vt / denomT;

        const muS = Math.max(A.staticFriction, B.staticFriction);
        const muK = Math.max(A.kineticFriction, B.kineticFriction);
        if (Math.abs(jt) > jImp * muS) {
          jt = -Math.sign(vt) * jImp * muK;
        }

        const fImpX = jt * tx, fImpY = jt * ty;
        if (!A.anchored) {
          A.vx -= fImpX * invMassA;
          A.vy -= fImpY * invMassA;
          A.omega -= (rAx * fImpY - rAy * fImpX) * invIA;
        }
        if (!B.anchored) {
          B.vx += fImpX * invMassB;
          B.vy += fImpY * invMassB;
          B.omega += (rBx * fImpY - rBy * fImpX) * invIB;
        }
      }
    }
  }
}

// --- FRAME-PACED SIMULATION LOOP ---
let rafId = null;
let lastFrameTime = 0;
let accumulator = 0;

function runSim() {
  if (state.running) return;
  if (state.time === 0) {
    initialSnapshot = JSON.stringify({
      bodies: state.bodies,
      forces: state.forces,
      constraints: state.constraints
    });
  }
  state.running = true;
  lastFrameTime = performance.now();
  accumulator = 0;
  document.getElementById('btn-run').classList.add('running');
  setStatus('Running simulation...');

  function loop(now) {
    if (!state.running) return;
    const elapsedSec = Math.min(0.05, Math.max(0, (now - lastFrameTime) / 1000));
    lastFrameTime = now;
    accumulator += elapsedSec;

    const fixedDt = 1 / Math.max(20, state.accuracyFPS);
    let subSteps = 0;
    while (accumulator >= fixedDt && subSteps < 14) {
      stepPhysics(fixedDt);
      accumulator -= fixedDt;
      subSteps++;
      if (!state.running) break;
    }

    updateUIReadouts();
    render();
    if (state.running) {
      rafId = requestAnimationFrame(loop);
    }
  }
  rafId = requestAnimationFrame(loop);
}

function stopSim() {
  state.running = false;
  accumulator = 0;
  document.getElementById('btn-run').classList.remove('running');
  if (rafId) {
    cancelAnimationFrame(rafId);
    rafId = null;
  }
  updateUIReadouts();
  render();
  setStatus('Simulation stopped.');
}

function resetSim() {
  stopSim();
  state.time = 0;
  state.frame = 0;
  if (initialSnapshot) {
    try {
      const snap = JSON.parse(initialSnapshot);
      state.bodies = snap.bodies;
      state.forces = snap.forces;
      state.constraints = snap.constraints;
    } catch (_) {}
  }
  state.bodies.forEach(b => { b.trail = []; });
  state.meters.forEach(m => {
    m.data = [];
    m.val1 = 0;
    m.val2 = 0;
    updateMeterDOM(m);
  });
  state.forces.forEach(updateForceComponents);
  updateUIReadouts();
  renderPropertiesWindow();
  render();
  setStatus('Reset to initial state (t = 0.00 s).');
}

function clearTrails() {
  state.bodies.forEach(b => { b.trail = []; });
  render();
}

// --- RENDERING ---
function render() {
  const w = canvas.width;
  const h = canvas.height;
  ctx.clearRect(0, 0, w, h);

  if (state.view.grid) drawGrid(w, h);
  if (state.view.axes) drawAxes(w, h);

  // Tracking trails
  if (state.view.tracking) {
    state.bodies.forEach(b => {
      if (!b.visible || !b.trail || b.trail.length < 2) return;
      ctx.save();
      ctx.strokeStyle = 'rgba(0, 102, 204, 0.45)';
      ctx.lineWidth = 1.2;
      ctx.setLineDash([2, 2]);
      ctx.beginPath();
      b.trail.forEach((pt, idx) => {
        const sp = worldToScreen(pt.x, pt.y);
        if (idx === 0) ctx.moveTo(sp.x, sp.y);
        else ctx.lineTo(sp.x, sp.y);
      });
      ctx.stroke();
      ctx.restore();
    });
  }

  state.bodies.forEach(b => {
    if (b.visible) drawBody(b);
  });

  state.constraints.forEach(drawConstraint);
  state.forces.forEach(drawForce);

  state.bodies.forEach(b => {
    if (!b.visible || b.anchored) return;
    const pos = worldToScreen(b.x, b.y);
    if (state.view.vectors.vel && Math.hypot(b.vx, b.vy) > 0.01) {
      drawArrow(pos.x, pos.y, pos.x + b.vx * 25, pos.y - b.vy * 25, '#008000', 'V');
    }
    if (state.view.vectors.acc && Math.hypot(b.ax, b.ay) > 0.01) {
      drawArrow(pos.x, pos.y, pos.x + b.ax * 15, pos.y - b.ay * 15, '#0000cc', 'A');
    }
  });

  state.texts.forEach(t => {
    const pos = worldToScreen(t.x, t.y);
    const isSel = state.selected?.type === 'text' && state.selected.id === t.id;
    ctx.save();
    ctx.font = 'bold 12px Tahoma';
    ctx.fillStyle = t.color || '#000';
    ctx.fillText(t.text, pos.x, pos.y);
    if (isSel) {
      const m = ctx.measureText(t.text);
      ctx.strokeStyle = '#0000ff';
      ctx.setLineDash([2, 2]);
      ctx.strokeRect(pos.x - 3, pos.y - 12, m.width + 6, 16);
    }
    ctx.restore();
  });

  if (state.view.rulers) drawRulers(w, h);
  if (dragDraw) drawCreationPreview();
  if (state.tool === 'polygon' && polyPoints.length > 0) drawPolygonInProgress();
}

function drawGrid(w, h) {
  const stepPx = Math.max(12, state.view.zoom);
  const origin = worldToScreen(0, 0);
  ctx.strokeStyle = '#e6e6e6';
  ctx.lineWidth = 1;
  ctx.beginPath();
  for (let x = ((origin.x % stepPx) + stepPx) % stepPx; x < w; x += stepPx) {
    ctx.moveTo(x, 0); ctx.lineTo(x, h);
  }
  for (let y = ((origin.y % stepPx) + stepPx) % stepPx; y < h; y += stepPx) {
    ctx.moveTo(0, y); ctx.lineTo(w, y);
  }
  ctx.stroke();
}

function drawAxes(w, h) {
  const origin = worldToScreen(0, 0);
  ctx.strokeStyle = '#808080';
  ctx.lineWidth = 1.5;
  ctx.beginPath();
  ctx.moveTo(0, origin.y); ctx.lineTo(w, origin.y);
  ctx.moveTo(origin.x, 0); ctx.lineTo(origin.x, h);
  ctx.stroke();

  ctx.fillStyle = '#555';
  ctx.font = '10px Tahoma';
  const step = state.view.zoom;
  for (let i = -25; i <= 25; i++) {
    if (i === 0) continue;
    const px = origin.x + i * step;
    if (px > 20 && px < w - 10) {
      ctx.beginPath(); ctx.moveTo(px, origin.y - 3); ctx.lineTo(px, origin.y + 3); ctx.stroke();
      ctx.fillText(i, px - 4, origin.y + 13);
    }
    const py = origin.y - i * step;
    if (py > 20 && py < h - 10) {
      ctx.beginPath(); ctx.moveTo(origin.x - 3, py); ctx.lineTo(origin.x + 3, py); ctx.stroke();
      ctx.fillText(i, origin.x + 6, py + 3);
    }
  }
}

function drawRulers(w, h) {
  const origin = worldToScreen(0, 0);
  ctx.fillStyle = '#f0f0f0';
  ctx.fillRect(0, 0, w, 16);
  ctx.fillRect(0, 0, 18, h);
  ctx.strokeStyle = '#808080';
  ctx.strokeRect(0, 0, w, 16);
  ctx.strokeRect(0, 0, 18, h);

  ctx.fillStyle = '#000';
  ctx.font = '9px Tahoma';
  const step = state.view.zoom;
  for (let i = -30; i <= 30; i++) {
    const px = origin.x + i * step;
    if (px > 18 && px < w) {
      ctx.beginPath(); ctx.moveTo(px, 10); ctx.lineTo(px, 16); ctx.stroke();
      ctx.fillText(i, px + 2, 10);
    }
    const py = origin.y - i * step;
    if (py > 16 && py < h) {
      ctx.beginPath(); ctx.moveTo(12, py); ctx.lineTo(18, py); ctx.stroke();
      ctx.fillText(i, 2, py - 2);
    }
  }
}

function getBodyHandlesScreen(b) {
  const pos = worldToScreen(b.x, b.y);
  const hw = (b.shape === 'circle' ? b.radius : b.width / 2) * state.view.zoom;
  const hh = (b.shape === 'circle' ? b.radius : b.height / 2) * state.view.zoom;
  const localHandles = [
    { id: 'nw', lx: -hw, ly: -hh },
    { id: 'n',  lx: 0,   ly: -hh },
    { id: 'ne', lx: hw,  ly: -hh },
    { id: 'e',  lx: hw,  ly: 0   },
    { id: 'se', lx: hw,  ly: hh  },
    { id: 's',  lx: 0,   ly: hh  },
    { id: 'sw', lx: -hw, ly: hh  },
    { id: 'w',  lx: -hw, ly: 0   },
    { id: 'rot', lx: 0,  ly: -hh - 22 }
  ];
  const c = Math.cos(-b.angle), s = Math.sin(-b.angle);
  return localHandles.map(h => ({
    id: h.id,
    x: pos.x + (h.lx * c - h.ly * s),
    y: pos.y + (h.lx * s + h.ly * c)
  }));
}

function drawBody(b) {
  const pos = worldToScreen(b.x, b.y);
  const isSel = state.selected && state.selected.type === 'body' && state.selected.id === b.id;
  const isHov = state.hovered && state.hovered.type === 'body' && state.hovered.id === b.id;

  ctx.save();
  ctx.translate(pos.x, pos.y);
  ctx.rotate(-b.angle);

  ctx.fillStyle = b.color;
  ctx.strokeStyle = isSel ? '#0000ff' : (isHov ? '#0066cc' : b.borderColor);
  ctx.lineWidth = isSel ? 2 : (isHov ? 1.8 : 1.2);

  if (b.shape === 'circle') {
    const rPx = b.radius * state.view.zoom;
    ctx.beginPath();
    ctx.arc(0, 0, rPx, 0, Math.PI * 2);
    ctx.fill();
    ctx.stroke();
    ctx.beginPath(); ctx.moveTo(0, 0); ctx.lineTo(rPx, 0); ctx.stroke();
  } else if (b.shape === 'rect') {
    const wPx = b.width * state.view.zoom;
    const hPx = b.height * state.view.zoom;
    ctx.fillRect(-wPx / 2, -hPx / 2, wPx, hPx);
    ctx.strokeRect(-wPx / 2, -hPx / 2, wPx, hPx);
  } else if (b.shape === 'polygon' && b.points.length > 2) {
    ctx.beginPath();
    b.points.forEach((pt, idx) => {
      const px = pt.x * state.view.zoom;
      const py = -pt.y * state.view.zoom;
      if (idx === 0) ctx.moveTo(px, py);
      else ctx.lineTo(px, py);
    });
    ctx.closePath();
    ctx.fill();
    ctx.stroke();
  } else if (b.shape === 'point') {
    ctx.beginPath();
    ctx.arc(0, 0, 3.5, 0, Math.PI * 2);
    ctx.fillStyle = '#000';
    ctx.fill();
  }

  if (b.anchored) {
    ctx.strokeStyle = '#333';
    ctx.lineWidth = 1.2;
    ctx.beginPath();
    ctx.moveTo(-5, 0); ctx.lineTo(5, 0);
    ctx.moveTo(0, -5); ctx.lineTo(0, 5);
    ctx.stroke();
    ctx.strokeRect(-4, -4, 8, 8);
  }

  // Selection Bounding Box, 8 Resize Handles & Top Rotation Handle
  if (isSel && b.shape !== 'point') {
    const hw = (b.shape === 'circle' ? b.radius : b.width / 2) * state.view.zoom;
    const hh = (b.shape === 'circle' ? b.radius : b.height / 2) * state.view.zoom;

    ctx.strokeStyle = '#000080';
    ctx.lineWidth = 1;
    ctx.setLineDash([2, 2]);
    ctx.strokeRect(-hw, -hh, hw * 2, hh * 2);
    ctx.setLineDash([]);

    // Rotation stem
    ctx.beginPath();
    ctx.moveTo(0, -hh);
    ctx.lineTo(0, -hh - 22);
    ctx.stroke();

    // Rotation knob
    ctx.fillStyle = '#00cc66';
    ctx.beginPath();
    ctx.arc(0, -hh - 22, 4.5, 0, Math.PI * 2);
    ctx.fill();
    ctx.stroke();

    // 8 Resize squares
    ctx.fillStyle = '#ffffff';
    ctx.strokeStyle = '#000000';
    [
      [-hw, -hh], [0, -hh], [hw, -hh],
      [hw, 0], [hw, hh], [0, hh],
      [-hw, hh], [-hw, 0]
    ].forEach(([hx, hy]) => {
      ctx.fillRect(hx - 3.5, hy - 3.5, 7, 7);
      ctx.strokeRect(hx - 3.5, hy - 3.5, 7, 7);
    });
  }

  ctx.restore();
}

function drawConstraint(c) {
  const b1 = state.bodies.find(b => b.id === c.b1);
  if (!b1) return;
  const r1 = rotateVec(c.off1x || 0, c.off1y || 0, b1.angle);
  const p1 = worldToScreen(b1.x + r1.x, b1.y + r1.y);
  const b2 = c.b2 ? state.bodies.find(b => b.id === c.b2) : null;
  const r2 = b2 ? rotateVec(c.off2x || 0, c.off2y || 0, b2.angle) : { x: 0, y: 0 };
  const p2 = b2 ? worldToScreen(b2.x + r2.x, b2.y + r2.y) : worldToScreen(c.wx, c.wy);
  const isSel = state.selected?.type === 'constraint' && state.selected.id === c.id;

  ctx.save();
  ctx.strokeStyle = isSel ? '#0000ff' : '#333';
  ctx.lineWidth = isSel ? 2.5 : 1.5;

  if (c.type === 'pin') {
    ctx.fillStyle = '#fff';
    ctx.beginPath(); ctx.arc(p1.x, p1.y, 4.5, 0, Math.PI * 2); ctx.fill(); ctx.stroke();
  } else if (c.type === 'rod') {
    ctx.beginPath(); ctx.moveTo(p1.x, p1.y); ctx.lineTo(p2.x, p2.y); ctx.stroke();
    ctx.fillStyle = '#fff';
    ctx.beginPath(); ctx.arc(p1.x, p1.y, 3.5, 0, Math.PI * 2); ctx.fill(); ctx.stroke();
    ctx.beginPath(); ctx.arc(p2.x, p2.y, 3.5, 0, Math.PI * 2); ctx.fill(); ctx.stroke();
  } else if (c.type === 'rope') {
    ctx.setLineDash([4, 3]);
    ctx.beginPath(); ctx.moveTo(p1.x, p1.y); ctx.lineTo(p2.x, p2.y); ctx.stroke();
  } else if (c.type === 'spring') {
    const dx = p2.x - p1.x;
    const dy = p2.y - p1.y;
    const len = Math.hypot(dx, dy);
    const ang = Math.atan2(dy, dx);
    ctx.translate(p1.x, p1.y);
    ctx.rotate(ang);
    ctx.beginPath();
    ctx.moveTo(0, 0);
    const coils = 10;
    for (let i = 1; i < coils; i++) {
      const x = (i / coils) * len;
      const y = (i % 2 === 0 ? -6 : 6);
      ctx.lineTo(x, y);
    }
    ctx.lineTo(len, 0);
    ctx.stroke();
  } else if (c.type === 'motor') {
    ctx.fillStyle = '#eee';
    ctx.beginPath(); ctx.arc(p1.x, p1.y, 8, 0, Math.PI * 2); ctx.fill(); ctx.stroke();
    ctx.fillStyle = '#000';
    ctx.font = 'bold 9px Tahoma';
    ctx.fillText('M', p1.x - 4, p1.y + 3);
  }
  ctx.restore();
}

function drawForce(f) {
  const b = state.bodies.find(item => item.id === f.bodyId);
  if (!b) return;
  const r = rotateVec(f.offsetX, f.offsetY, b.angle);
  const start = worldToScreen(b.x + r.x, b.y + r.y);
  const scale = 6;
  const endX = start.x + f.fx * scale;
  const endY = start.y - f.fy * scale;
  const isSel = state.selected && state.selected.type === 'force' && state.selected.id === f.id;
  drawArrow(start.x, start.y, endX, endY, isSel ? '#0000ff' : f.color, `F[${f.id}] (${formatNum(f.mag)}N)`);

  if (isSel) {
    ctx.save();
    ctx.fillStyle = '#ffff00';
    ctx.strokeStyle = '#000';
    ctx.beginPath();
    ctx.arc(endX, endY, 4.5, 0, Math.PI * 2);
    ctx.fill();
    ctx.stroke();
    ctx.restore();
  }
}

function drawArrow(x1, y1, x2, y2, color, label) {
  const ang = Math.atan2(y2 - y1, x2 - x1);
  const headLen = 10;
  ctx.save();
  ctx.strokeStyle = color;
  ctx.fillStyle = color;
  ctx.lineWidth = 2;
  ctx.beginPath();
  ctx.moveTo(x1, y1);
  ctx.lineTo(x2, y2);
  ctx.stroke();

  ctx.beginPath();
  ctx.moveTo(x2, y2);
  ctx.lineTo(x2 - headLen * Math.cos(ang - Math.PI / 6), y2 - headLen * Math.sin(ang - Math.PI / 6));
  ctx.lineTo(x2 - headLen * Math.cos(ang + Math.PI / 6), y2 - headLen * Math.sin(ang + Math.PI / 6));
  ctx.closePath();
  ctx.fill();

  if (label) {
    ctx.font = 'bold 10px Tahoma';
    ctx.fillText(label, x2 + 6, y2 - 4);
  }
  ctx.restore();
}

// --- UNIFIED POINTER INTERACTION (SELECT, RESIZE, ROTATE, FORCE DRAG, DRAW) ---
let activeAction = null; // { mode: 'moveBody'|'resize'|'rotate'|'dragForceTip'|'moveText'|'pan', ... }
let dragDraw = null;
let polyPoints = [];

function getCanvasPointFromClient(clientX, clientY) {
  const rect = canvas.getBoundingClientRect();
  const sx = clientX - rect.left;
  const sy = clientY - rect.top;
  return { sx, sy, wPos: screenToWorld(sx, sy) };
}

function hitTestHandles(sx, sy) {
  if (!state.selected) return null;
  if (state.selected.type === 'body') {
    const b = state.bodies.find(item => item.id === state.selected.id);
    if (!b || b.shape === 'point') return null;
    const handles = getBodyHandlesScreen(b);
    for (let h of handles) {
      if (Math.hypot(sx - h.x, sy - h.y) <= 8) {
        return { kind: h.id === 'rot' ? 'rotate' : 'resize', handleId: h.id, body: b };
      }
    }
  } else if (state.selected.type === 'force') {
    const f = state.forces.find(item => item.id === state.selected.id);
    const b = f ? state.bodies.find(item => item.id === f.bodyId) : null;
    if (f && b) {
      const r = rotateVec(f.offsetX, f.offsetY, b.angle);
      const start = worldToScreen(b.x + r.x, b.y + r.y);
      const endX = start.x + f.fx * 6;
      const endY = start.y - f.fy * 6;
      if (Math.hypot(sx - endX, sy - endY) <= 10) {
        return { kind: 'dragForceTip', force: f, body: b };
      }
    }
  }
  return null;
}

function handlePointerDown(clientX, clientY, button = 0) {
  closeAllMenus();
  hideContextMenu();
  const { sx, sy, wPos } = getCanvasPointFromClient(clientX, clientY);
  const snapped = applySnap(wPos);

  if (state.tool === 'select') {
    // 1. Check active selection handles first (Resize, Rotate, Force Tip)
    const handleHit = hitTestHandles(sx, sy);
    if (handleHit && button === 0) {
      saveUndoSnapshot();
      if (handleHit.kind === 'rotate') {
        activeAction = { mode: 'rotate', body: handleHit.body };
      } else if (handleHit.kind === 'resize') {
        activeAction = {
          mode: 'resize',
          handleId: handleHit.handleId,
          body: handleHit.body,
          origW: handleHit.body.width,
          origH: handleHit.body.height,
          origR: handleHit.body.radius
        };
      } else if (handleHit.kind === 'dragForceTip') {
        activeAction = { mode: 'dragForceTip', force: handleHit.force, body: handleHit.body };
      }
      return;
    }

    // 2. Hit test all canvas elements
    const hit = hitTest(sx, sy, wPos);
    state.selected = hit;
    renderPropertiesWindow();
    renderAppearanceWindow();
    renderGeometryWindow();

    if (button === 2) {
      render();
      showContextMenu(clientX, clientY, hit, wPos);
      return;
    }

    if (hit && hit.type === 'body') {
      const b = state.bodies.find(item => item.id === hit.id);
      if (b) {
        saveUndoSnapshot();
        activeAction = { mode: 'moveBody', body: b, offX: wPos.x - b.x, offY: wPos.y - b.y };
      }
    } else if (hit && hit.type === 'text') {
      const t = state.texts.find(item => item.id === hit.id);
      if (t) {
        saveUndoSnapshot();
        activeAction = { mode: 'moveText', textObj: t, offX: wPos.x - t.x, offY: wPos.y - t.y };
      }
    } else if (!hit) {
      activeAction = { mode: 'pan', startSx: sx - state.view.panX, startSy: sy - state.view.panY };
    }
    render();
  } else if (state.tool === 'zoom') {
    zoomCanvas(1.25);
  } else if (state.tool === 'text') {
    openPromptModal('Text Annotation', 'Enter label text:', 'Label', (txt) => {
      if (txt) {
        saveUndoSnapshot();
        const t = { id: nextId.text++, x: snapped.x, y: snapped.y, text: txt };
        state.texts.push(t);
        selectObject('text', t.id);
        setTool('select');
      }
    });
  } else if (state.tool === 'point') {
    saveUndoSnapshot();
    const b = createBody({ shape: 'point', x: snapped.x, y: snapped.y, mass: 0.01 });
    selectObject('body', b.id);
    setTool('select');
  } else if (state.tool === 'anchor') {
    const hit = hitTest(sx, sy, wPos);
    if (hit && hit.type === 'body') {
      saveUndoSnapshot();
      const b = state.bodies.find(item => item.id === hit.id);
      if (b) {
        b.anchored = !b.anchored;
        b.color = b.anchored ? '#c0c0c0' : '#99ccff';
        renderPropertiesWindow();
        render();
      }
    }
    setTool('select');
  } else if (['circle', 'rect', 'square', 'force', 'spring', 'rod', 'rope'].includes(state.tool)) {
    dragDraw = { tool: state.tool, x1: snapped.x, y1: snapped.y, x2: snapped.x, y2: snapped.y };
  } else if (state.tool === 'polygon') {
    polyPoints.push({ x: snapped.x, y: snapped.y });
    render();
  } else if (state.tool === 'pin' || state.tool === 'motor') {
    const hit = hitTest(sx, sy, wPos);
    if (hit && hit.type === 'body') {
      saveUndoSnapshot();
      const b = state.bodies.find(item => item.id === hit.id);
      if (b) {
        const localOff = rotateVec(wPos.x - b.x, wPos.y - b.y, -b.angle);
        const c = {
          id: nextId.constraint++,
          type: state.tool,
          b1: b.id,
          off1x: localOff.x,
          off1y: localOff.y,
          wx: wPos.x,
          wy: wPos.y,
          speed: 2.0
        };
        state.constraints.push(c);
        selectObject('constraint', c.id);
        setTool('select');
      }
    }
  } else if (state.tool === 'rotate') {
    const hit = hitTest(sx, sy, wPos);
    if (hit && hit.type === 'body') {
      saveUndoSnapshot();
      const b = state.bodies.find(item => item.id === hit.id);
      selectObject('body', hit.id);
      activeAction = { mode: 'rotate', body: b };
    }
  }
}

function handlePointerMove(clientX, clientY) {
  const { sx, sy, wPos } = getCanvasPointFromClient(clientX, clientY);
  const snapped = applySnap(wPos);
  document.getElementById('status-coords').textContent =
    `X: ${formatNum(wPos.x)} m  Y: ${formatNum(wPos.y)} m`;

  if (activeAction) {
    if (activeAction.mode === 'pan') {
      state.view.panX = sx - activeAction.startSx;
      state.view.panY = sy - activeAction.startSy;
    } else if (activeAction.mode === 'moveBody') {
      const target = applySnap({ x: wPos.x - activeAction.offX, y: wPos.y - activeAction.offY });
      activeAction.body.x = target.x;
      activeAction.body.y = target.y;
      renderPropertiesWindow();
    } else if (activeAction.mode === 'moveText') {
      const target = applySnap({ x: wPos.x - activeAction.offX, y: wPos.y - activeAction.offY });
      activeAction.textObj.x = target.x;
      activeAction.textObj.y = target.y;
    } else if (activeAction.mode === 'rotate') {
      const b = activeAction.body;
      b.angle = Math.atan2(wPos.y - b.y, wPos.x - b.x) - Math.PI / 2;
      renderPropertiesWindow();
    } else if (activeAction.mode === 'resize') {
      const b = activeAction.body;
      const local = rotateVec(wPos.x - b.x, wPos.y - b.y, -b.angle);
      if (b.shape === 'circle') {
        b.radius = Math.max(0.15, Math.hypot(local.x, local.y));
      } else {
        const hid = activeAction.handleId;
        if (hid.includes('e') || hid.includes('w')) b.width = Math.max(0.2, Math.abs(local.x) * 2);
        if (hid.includes('n') || hid.includes('s')) b.height = Math.max(0.2, Math.abs(local.y) * 2);
      }
      renderGeometryWindow();
    } else if (activeAction.mode === 'dragForceTip') {
      const f = activeAction.force;
      const b = activeAction.body;
      const r = rotateVec(f.offsetX, f.offsetY, b.angle);
      const start = worldToScreen(b.x + r.x, b.y + r.y);
      const fxNew = (sx - start.x) / 6;
      const fyNew = (start.y - sy) / 6;
      f.fxFormula = null;
      f.fyFormula = null;
      f.magFormula = null;
      f.dirFormula = null;
      f.fx = fxNew;
      f.fy = fyNew;
      f.mag = Math.hypot(fxNew, fyNew);
      f.dir = Math.atan2(fyNew, fxNew);
      renderPropertiesWindow();
    }
    render();
    return;
  }

  if (dragDraw) {
    dragDraw.x2 = snapped.x;
    dragDraw.y2 = snapped.y;
    render();
    return;
  }

  // Dynamic hover cursor feedback
  if (state.tool === 'select') {
    const hHandle = hitTestHandles(sx, sy);
    if (hHandle) {
      canvas.style.cursor = hHandle.kind === 'rotate' ? 'grab' : 'nwse-resize';
      return;
    }
    const hit = hitTest(sx, sy, wPos);
    state.hovered = hit;
    canvas.style.cursor = hit ? 'move' : 'default';
  } else {
    canvas.style.cursor = 'crosshair';
  }
}

function handlePointerUp() {
  if (activeAction) {
    activeAction = null;
  }
  if (dragDraw) {
    finishDragDraw();
    dragDraw = null;
    render();
  }
}

canvas.addEventListener('contextmenu', (e) => e.preventDefault());
canvas.addEventListener('mousedown', (e) => handlePointerDown(e.clientX, e.clientY, e.button));
window.addEventListener('mousemove', (e) => {
  if (activeAction || dragDraw) {
    handlePointerMove(e.clientX, e.clientY);
  } else if (e.target === canvas) {
    handlePointerMove(e.clientX, e.clientY);
  }
});
window.addEventListener('mouseup', () => handlePointerUp());

canvas.addEventListener('touchstart', (e) => {
  if (e.touches.length > 0) {
    e.preventDefault();
    handlePointerDown(e.touches[0].clientX, e.touches[0].clientY, 0);
  }
}, { passive: false });

canvas.addEventListener('touchmove', (e) => {
  if (e.touches.length > 0) {
    e.preventDefault();
    handlePointerMove(e.touches[0].clientX, e.touches[0].clientY);
  }
}, { passive: false });

canvas.addEventListener('touchend', (e) => {
  e.preventDefault();
  handlePointerUp();
}, { passive: false });

canvas.addEventListener('dblclick', () => {
  if (state.tool === 'polygon' && polyPoints.length >= 3) {
    saveUndoSnapshot();
    const cx = polyPoints.reduce((s, p) => s + p.x, 0) / polyPoints.length;
    const cy = polyPoints.reduce((s, p) => s + p.y, 0) / polyPoints.length;
    const localPts = polyPoints.map(p => ({ x: p.x - cx, y: p.y - cy }));
    const b = createBody({ shape: 'polygon', x: cx, y: cy, points: localPts, width: 1.5, height: 1.5 });
    polyPoints = [];
    selectObject('body', b.id);
    setTool('select');
    render();
  } else if (state.selected) {
    openFloatingWin('win-properties');
  }
});

function drawPolygonInProgress() {
  ctx.save();
  ctx.strokeStyle = '#0000ff';
  ctx.fillStyle = '#0000ff';
  ctx.beginPath();
  polyPoints.forEach((pt, idx) => {
    const sp = worldToScreen(pt.x, pt.y);
    if (idx === 0) ctx.moveTo(sp.x, sp.y);
    else ctx.lineTo(sp.x, sp.y);
    ctx.fillRect(sp.x - 3, sp.y - 3, 6, 6);
  });
  ctx.stroke();
  ctx.restore();
}

function drawCreationPreview() {
  const p1 = worldToScreen(dragDraw.x1, dragDraw.y1);
  const p2 = worldToScreen(dragDraw.x2, dragDraw.y2);
  const dx = dragDraw.x2 - dragDraw.x1;
  const dy = dragDraw.y2 - dragDraw.y1;
  const dist = Math.hypot(dx, dy);

  ctx.save();
  ctx.strokeStyle = '#0000ff';
  ctx.fillStyle = '#000080';
  ctx.font = 'bold 10px Tahoma';
  ctx.setLineDash([3, 3]);

  let label = '';
  if (dragDraw.tool === 'circle') {
    const r = Math.hypot(p2.x - p1.x, p2.y - p1.y);
    ctx.beginPath(); ctx.arc(p1.x, p1.y, r, 0, Math.PI * 2); ctx.stroke();
    label = `R: ${dist.toFixed(2)} m`;
  } else if (dragDraw.tool === 'rect' || dragDraw.tool === 'square') {
    const w = p2.x - p1.x;
    const h = dragDraw.tool === 'square' ? Math.sign(p2.y - p1.y || 1) * Math.abs(w) : (p2.y - p1.y);
    ctx.strokeRect(p1.x, p1.y, w, h);
    label = `W: ${Math.abs(dx).toFixed(2)}m, H: ${(dragDraw.tool === 'square' ? Math.abs(dx) : Math.abs(dy)).toFixed(2)}m`;
  } else if (dragDraw.tool === 'force') {
    ctx.beginPath(); ctx.moveTo(p1.x, p1.y); ctx.lineTo(p2.x, p2.y); ctx.stroke();
    const fMag = dist > 0.1 ? dist * 5 : 10;
    const deg = ((Math.atan2(dy, dx) * 180 / Math.PI) + 360) % 360;
    label = `F: ${fMag.toFixed(1)} N, θ: ${deg.toFixed(0)}°`;
  } else {
    ctx.beginPath(); ctx.moveTo(p1.x, p1.y); ctx.lineTo(p2.x, p2.y); ctx.stroke();
    label = `L: ${dist.toFixed(2)} m`;
  }

  if (label) {
    ctx.fillText(label, p2.x + 8, p2.y - 6);
  }
  ctx.restore();
}

function finishDragDraw() {
  const { tool, x1, y1, x2, y2 } = dragDraw;
  const dx = x2 - x1;
  const dy = y2 - y1;
  const dist = Math.hypot(dx, dy);

  if (tool === 'circle') {
    saveUndoSnapshot();
    const b = createBody({ shape: 'circle', x: x1, y: y1, radius: Math.max(0.25, dist) });
    selectObject('body', b.id);
  } else if (tool === 'rect' || tool === 'square') {
    saveUndoSnapshot();
    const w = Math.max(0.35, Math.abs(dx));
    const h = tool === 'square' ? w : Math.max(0.35, Math.abs(dy));
    const b = createBody({ shape: 'rect', x: (x1 + x2) / 2, y: (y1 + y2) / 2, width: w, height: h });
    selectObject('body', b.id);
  } else if (tool === 'force') {
    const s1 = worldToScreen(x1, y1);
    const hit = hitTest(s1.x, s1.y, { x: x1, y: y1 });
    if (hit && hit.type === 'body') {
      saveUndoSnapshot();
      const b = state.bodies.find(item => item.id === hit.id);
      const localOff = rotateVec(x1 - b.x, y1 - b.y, -b.angle);
      const fx = dist > 0.1 ? dx * 5 : 10;
      const fy = dist > 0.1 ? dy * 5 : 0;
      const f = createForce({ bodyId: b.id, offsetX: localOff.x, offsetY: localOff.y, fx, fy });
      selectObject('force', f.id);
    } else {
      setStatus('Drag starting on a body to attach a Force vector.');
    }
  } else if (['spring', 'rod', 'rope'].includes(tool)) {
    const s1 = worldToScreen(x1, y1);
    const s2 = worldToScreen(x2, y2);
    const h1 = hitTest(s1.x, s1.y, { x: x1, y: y1 });
    const h2 = hitTest(s2.x, s2.y, { x: x2, y: y2 });
    if (h1 && h1.type === 'body') {
      saveUndoSnapshot();
      const b1 = state.bodies.find(b => b.id === h1.id);
      const b2 = (h2 && h2.type === 'body' && h2.id !== b1.id) ? state.bodies.find(b => b.id === h2.id) : null;
      const off1 = rotateVec(x1 - b1.x, y1 - b1.y, -b1.angle);
      const off2 = b2 ? rotateVec(x2 - b2.x, y2 - b2.y, -b2.angle) : { x: 0, y: 0 };
      const c = {
        id: nextId.constraint++,
        type: tool,
        b1: b1.id,
        off1x: off1.x,
        off1y: off1.y,
        b2: b2 ? b2.id : null,
        off2x: off2.x,
        off2y: off2.y,
        wx: x2,
        wy: y2,
        restLength: Math.max(0.25, dist),
        stiffness: 30
      };
      state.constraints.push(c);
      selectObject('constraint', c.id);
    }
  }
  setTool('select');
}

function hitTest(sx, sy, wPos) {
  // 1. Check Forces
  for (let i = state.forces.length - 1; i >= 0; i--) {
    const f = state.forces[i];
    const b = state.bodies.find(item => item.id === f.bodyId);
    if (!b) continue;
    const r = rotateVec(f.offsetX, f.offsetY, b.angle);
    const p1 = worldToScreen(b.x + r.x, b.y + r.y);
    const p2 = { x: p1.x + f.fx * 6, y: p1.y - f.fy * 6 };
    if (distToSegment(sx, sy, p1.x, p1.y, p2.x, p2.y) < 11) {
      return { type: 'force', id: f.id };
    }
  }

  // 2. Check Constraints
  for (let i = state.constraints.length - 1; i >= 0; i--) {
    const c = state.constraints[i];
    const b1 = state.bodies.find(b => b.id === c.b1);
    if (!b1) continue;
    const r1 = rotateVec(c.off1x || 0, c.off1y || 0, b1.angle);
    const p1 = worldToScreen(b1.x + r1.x, b1.y + r1.y);
    if (c.type === 'pin' || c.type === 'motor') {
      if (Math.hypot(sx - p1.x, sy - p1.y) < 10) return { type: 'constraint', id: c.id };
    } else {
      const b2 = c.b2 ? state.bodies.find(b => b.id === c.b2) : null;
      const r2 = b2 ? rotateVec(c.off2x || 0, c.off2y || 0, b2.angle) : { x: 0, y: 0 };
      const p2 = b2 ? worldToScreen(b2.x + r2.x, b2.y + r2.y) : worldToScreen(c.wx, c.wy);
      if (distToSegment(sx, sy, p1.x, p1.y, p2.x, p2.y) < 9) return { type: 'constraint', id: c.id };
    }
  }

  // 3. Check Texts
  for (let i = state.texts.length - 1; i >= 0; i--) {
    const t = state.texts[i];
    const sp = worldToScreen(t.x, t.y);
    if (sx >= sp.x - 4 && sx <= sp.x + 70 && sy >= sp.y - 14 && sy <= sp.y + 4) {
      return { type: 'text', id: t.id };
    }
  }

  // 4. Check Bodies (rotated local frame)
  for (let i = state.bodies.length - 1; i >= 0; i--) {
    const b = state.bodies[i];
    if (!b.visible) continue;
    const local = rotateVec(wPos.x - b.x, wPos.y - b.y, -b.angle);
    if (b.shape === 'circle') {
      if (Math.hypot(local.x, local.y) <= b.radius) return { type: 'body', id: b.id };
    } else if (b.shape === 'point') {
      if (Math.hypot(local.x, local.y) <= 0.28) return { type: 'body', id: b.id };
    } else {
      if (Math.abs(local.x) <= b.width / 2 && Math.abs(local.y) <= b.height / 2) {
        return { type: 'body', id: b.id };
      }
    }
  }
  return null;
}

function distToSegment(px, py, x1, y1, x2, y2) {
  const l2 = (x2 - x1) ** 2 + (y2 - y1) ** 2;
  if (l2 === 0) return Math.hypot(px - x1, py - y1);
  let t = ((px - x1) * (x2 - x1) + (py - y1) * (y2 - y1)) / l2;
  t = Math.max(0, Math.min(1, t));
  return Math.hypot(px - (x1 + t * (x2 - x1)), py - (y1 + t * (y2 - y1)));
}

function selectObject(type, id) {
  state.selected = { type, id };
  renderPropertiesWindow();
  renderAppearanceWindow();
  renderGeometryWindow();
  render();
}

