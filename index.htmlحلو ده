}

function makeDraggable(el) {
  const header = el.querySelector('.fw-header, .cw-title');
  if (!header) return;

  header.addEventListener('mousedown', (e) => {
    if (e.target.closest('span[title], .win-btn')) return;
    e.stopPropagation();
    startDrag(e.clientX, e.clientY);
  });

  header.addEventListener('touchstart', (e) => {
    if (e.target.closest('span[title], .win-btn')) return;
    if (e.touches.length > 0) {
      e.stopPropagation();
      startDrag(e.touches[0].clientX, e.touches[0].clientY);
    }
  }, { passive: true });

  function startDrag(clientX, clientY) {
    const wRect = wrapper.getBoundingClientRect();
    const eRect = el.getBoundingClientRect();
    const startX = clientX;
    const startY = clientY;
    const origLeft = eRect.left - wRect.left;
    const origTop = eRect.top - wRect.top;
    el.style.right = 'auto';

    function move(cx, cy) {
      const maxX = Math.max(4, wrapper.clientWidth - el.offsetWidth - 4);
      const maxY = Math.max(4, wrapper.clientHeight - el.offsetHeight - 4);
      const nextL = Math.max(4, Math.min(maxX, origLeft + (cx - startX)));
      const nextT = Math.max(4, Math.min(maxY, origTop + (cy - startY)));
      el.style.left = nextL + 'px';
      el.style.top = nextT + 'px';
    }

    function onMouseMove(ev) { move(ev.clientX, ev.clientY); }
    function onTouchMove(ev) {
      if (ev.touches.length > 0) move(ev.touches[0].clientX, ev.touches[0].clientY);
    }
    function cleanup() {
      window.removeEventListener('mousemove', onMouseMove);
      window.removeEventListener('mouseup', cleanup);
      window.removeEventListener('touchmove', onTouchMove);
      window.removeEventListener('touchend', cleanup);
    }

    window.addEventListener('mousemove', onMouseMove);
    window.addEventListener('mouseup', cleanup);
    window.addEventListener('touchmove', onTouchMove, { passive: true });
    window.addEventListener('touchend', cleanup);
  }
}

// Menu bar behavior
document.querySelectorAll('#menu-bar > .menu-item').forEach(item => {
  item.addEventListener('click', (e) => {
    if (e.target.closest('.dd-item') && !e.target.closest('.dd-sub')) {
      closeAllMenus();
      return;
    }
    e.stopPropagation();
    const wasActive = item.classList.contains('active');
    closeAllMenus();
    if (!wasActive) item.classList.add('active');
  });

  item.addEventListener('mouseenter', () => {
    if (window.innerWidth > 700 && document.querySelector('#menu-bar > .menu-item.active')) {
      closeAllMenus();
      item.classList.add('active');
    }
  });
});

function toggleSubmenu(e, subEl) {
  e.stopPropagation();
  subEl.classList.toggle('open');
}

function closeAllMenus() {
  document.querySelectorAll('#menu-bar > .menu-item').forEach(m => m.classList.remove('active'));
  document.querySelectorAll('.dd-sub').forEach(s => s.classList.remove('open'));
  hideContextMenu();
}

window.addEventListener('click', closeAllMenus);

window.addEventListener('keydown', (e) => {
  if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA' || e.target.tagName === 'SELECT') return;
  if (e.key === 'Delete' || e.key === 'Backspace') { e.preventDefault(); cmdDelete(); }
  if (e.key === 'Escape') { closeModal(); closeAllMenus(); }
  if (e.ctrlKey && e.key.toLowerCase() === 'z') { e.preventDefault(); cmdUndo(); }
  if (e.ctrlKey && e.key.toLowerCase() === 'y') { e.preventDefault(); cmdRedo(); }
  if (e.ctrlKey && e.key.toLowerCase() === 'i') { e.preventDefault(); openFloatingWin('win-properties'); }
  if (e.ctrlKey && e.key.toLowerCase() === 'd') { e.preventDefault(); cmdDuplicate(); }
  if (e.key === ' ') { e.preventDefault(); state.running ? stopSim() : runSim(); }
});

function formatNum(val) {
  if (typeof val !== 'number' || Number.isNaN(val)) return '0';
  return val.toFixed(state.decimalDigits);
}

function updateUIReadouts() {
  document.getElementById('status-time').textContent = `Time: ${state.time.toFixed(2)} s`;
}

function setStatus(msg) {
  document.getElementById('status-msg').textContent = msg;
}

function initDefaultScene() {
  performNewReset();
  createBody({ name: 'Body[1]', shape: 'rect', x: 0, y: 2, width: 1, height: 1, mass: 2, color: '#99ccff' });
  createBody({ name: 'Body[2]', shape: 'rect', x: 0, y: -1, width: 12, height: 0.5, anchored: true, color: '#c0c0c0' });
  render();
}

['win-properties', 'win-appearance', 'win-geometry'].forEach(id => {
  makeDraggable(document.getElementById(id));
});

resizeCanvas();
initDefaultScene();
