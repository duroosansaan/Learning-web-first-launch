}

function cmdSave() {
  const blob = new Blob([JSON.stringify(state)], { type: 'application/json' });
  const a = document.createElement('a');
  a.href = URL.createObjectURL(blob);
  a.download = 'Experiment.ip.json';
  a.click();
  setTimeout(() => URL.revokeObjectURL(a.href), 1000);
  setStatus('Experiment saved as Experiment.ip.json');
}

function cmdSaveAs() {
  openPromptModal('Save As', 'Enter experiment file name:', 'MyExperiment.ip', (name) => {
    if (name) {
      document.getElementById('window-title').textContent = `Interactive Physics - [${name}]`;
      cmdSave();
    }
  });
}

function cmdOpen() {
  const inp = document.createElement('input');
  inp.type = 'file';
  inp.accept = '.json,.ip';
  inp.onchange = (e) => {
    const file = e.target.files[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = (ev) => {
      try {
        const loaded = JSON.parse(ev.target.result);
        performNewReset();
        Object.assign(state, loaded);
        state.running = false;
        state.controls.forEach(spawnControlWidget);
        state.meters.forEach(spawnMeterWidget);
        render();
        setStatus(`Loaded ${file.name}`);
      } catch (_) {
        showModal('Open Error', '<div>Invalid experiment file format.</div><div style="text-align:right; margin-top:8px;"><button class="win-action-btn" onclick="closeModal()">OK</button></div>');
      }
    };
    reader.readAsText(file);
  };
  inp.click();
}

function cmdRevert() { resetSim(); }

function cmdExportCSV() {
  if (state.meters.length === 0) {
    showModal('Export CSV', '<div>No Measure windows are open to export.</div><div style="text-align:right; margin-top:8px;"><button class="win-action-btn" onclick="closeModal()">OK</button></div>');
    return;
  }
  const m = state.meters[0];
  let csv = `Time,${m.y1Label},${m.y2Label}\n`;
  m.data.forEach(d => { csv += `${d.t},${d.v1},${d.v2}\n`; });
  const a = document.createElement('a');
  a.href = URL.createObjectURL(new Blob([csv], { type: 'text/csv' }));
  a.download = 'physics_data.csv';
  a.click();
  setTimeout(() => URL.revokeObjectURL(a.href), 1000);
}

function cmdDuplicate() {
  if (!state.selected || state.selected.type !== 'body') return;
  const orig = state.bodies.find(b => b.id === state.selected.id);
  if (!orig) return;
  const copy = createBody({ ...orig, x: orig.x + 0.5, y: orig.y + 0.5 });
  selectObject('body', copy.id);
}

function cmdDelete() {
  if (!state.selected) return;
  if (state.selected.type === 'body') {
    state.bodies = state.bodies.filter(b => b.id !== state.selected.id);
    state.forces = state.forces.filter(f => f.bodyId !== state.selected.id);
  } else if (state.selected.type === 'force') {
    state.forces = state.forces.filter(f => f.id !== state.selected.id);
  } else if (state.selected.type === 'meter') {
    removeMeter(state.selected.id);
  }
  state.selected = null;
  renderPropertiesWindow();
  renderAppearanceWindow();
  renderGeometryWindow();
  render();
}

function cmdCopy() {
  if (state.selected?.type === 'body') {
    state.clipboard = JSON.parse(JSON.stringify(state.bodies.find(b => b.id === state.selected.id)));
  }
}
function cmdCut() { cmdCopy(); cmdDelete(); }
function cmdPaste() {
  if (state.clipboard) {
    const b = createBody({ ...state.clipboard, x: state.clipboard.x + 0.5, y: state.clipboard.y + 0.5 });
    selectObject('body', b.id);
  }
}
function cmdUndo() { resetSim(); }
function cmdRedo() { setStatus('Nothing to redo.'); }
function cmdSelectAll() {
  if (state.bodies.length > 0) selectObject('body', state.bodies[0].id);
}
function cmdAnchorSelected() {
  if (state.selected?.type === 'body') {
    const b = state.bodies.find(x => x.id === state.selected.id);
    if (b) {
      b.anchored = !b.anchored;
      renderPropertiesWindow();
      render();
    }
  }
}
function cmdJoinSelected() {
  if (state.bodies.length >= 2) {
    const b1 = state.bodies[0], b2 = state.bodies[1];
    state.constraints.push({ type: 'pin', b1: b1.id, b2: b2.id, off1x: 0, off1y: 0, off2x: 0, off2y: 0 });
    render();
  }
}
function cmdSplitSelected() {
  state.constraints = [];
  render();
}
function cmdBringToFront() {
  if (state.selected?.type === 'body') {
    const idx = state.bodies.findIndex(b => b.id === state.selected.id);
    if (idx > -1) state.bodies.push(state.bodies.splice(idx, 1)[0]);
    render();
  }
}
function cmdSendToBack() {
  if (state.selected?.type === 'body') {
    const idx = state.bodies.findIndex(b => b.id === state.selected.id);
    if (idx > -1) state.bodies.unshift(state.bodies.splice(idx, 1)[0]);
    render();
  }
}

function zoomCanvas(factor) {
  state.view.zoom = Math.max(12, Math.min(280, state.view.zoom * factor));
  render();
}
function zoomToFit() {
  state.view.zoom = 60;
  state.view.panX = 0;
  state.view.panY = 0;
  render();
}
function toggleViewFlag(flag) {
  state.view[flag] = !state.view[flag];
  const chk = document.getElementById(`chk-${flag}`);
  if (chk) chk.textContent = state.view[flag] ? '✓' : '';
  if (flag === 'snap') {
    const tb = document.getElementById('tb-snap');
    if (tb) tb.style.background = state.view.snap ? '#c8c4bc' : '';
  }
  render();
}

function cmdDuplicate() {
  if (!state.selected || state.selected.type !== 'body') return;
  const orig = state.bodies.find(b => b.id === state.selected.id);
  if (!orig) return;
  saveUndoSnapshot();
  const copy = createBody({ ...orig, trail: [], x: orig.x + 0.5, y: orig.y + 0.5 });
  selectObject('body', copy.id);
}

function cmdDelete() {
  if (!state.selected) return;
  saveUndoSnapshot();
  const { type, id } = state.selected;
  if (type === 'body') {
    state.bodies = state.bodies.filter(b => b.id !== id);
    state.forces = state.forces.filter(f => f.bodyId !== id);
    state.constraints = state.constraints.filter(c => c.b1 !== id && c.b2 !== id);
  } else if (type === 'force') {
    state.forces = state.forces.filter(f => f.id !== id);
  } else if (type === 'constraint') {
    state.constraints = state.constraints.filter(c => c.id !== id);
  } else if (type === 'meter') {
    removeMeter(id);
  } else if (type === 'control') {
    removeControl(id);
  } else if (type === 'text') {
    state.texts = state.texts.filter(t => t.id !== id);
  }
  state.selected = null;
  renderPropertiesWindow();
  renderAppearanceWindow();
  renderGeometryWindow();
  render();
  setStatus('Element deleted.');
}

function cmdUndo() {
  if (state.undoStack.length === 0) {
    resetSim();
    return;
  }
  const current = JSON.stringify({
    bodies: state.bodies,
    forces: state.forces,
    constraints: state.constraints,
    controls: state.controls,
    meters: state.meters,
    texts: state.texts,
    nextId: { ...nextId }
  });
  state.redoStack.push(current);
  const prev = state.undoStack.pop();
  restoreFullSnapshot(prev);
  setStatus('Undo completed.');
}

function cmdRedo() {
  if (state.redoStack.length === 0) {
    setStatus('Nothing to redo.');
    return;
  }
  const current = JSON.stringify({
    bodies: state.bodies,
    forces: state.forces,
    constraints: state.constraints,
    controls: state.controls,
    meters: state.meters,
    texts: state.texts,
    nextId: { ...nextId }
  });
  state.undoStack.push(current);
  const next = state.redoStack.pop();
  restoreFullSnapshot(next);
  setStatus('Redo completed.');
}

